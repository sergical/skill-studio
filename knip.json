{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "doctor.config.ts",
        ".cursor/skills/verify-skill-studio/playwright.config.ts",
        "tools/oxlint/anti-slop/shared/*.integration.test.ts"
      ],
      "project": ["tools/oxlint/anti-slop/**/*.ts", "*.ts"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "apps/tui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/lib": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/skill-types.generated.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/marketing": {
      "ignoreBinaries": ["agent-browser"],
      "entry": ["src/remotion/index.ts", "src/prerender/site-prerender.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
