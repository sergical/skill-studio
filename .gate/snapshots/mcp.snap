          ]
        }
      },
      "type": "object"
    },
    "name": "diagnose_conflict"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
          "default": null,
