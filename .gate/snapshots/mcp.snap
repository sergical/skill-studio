                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to the global shared library folder."
        },
        "skills": {
          "default": [],
          "description": "Restrict to these skill names; empty means all.",
          "items": {
            "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
            "type": "string",
            "x-untrusted": true
          },
          "type": "array"
        },
        "source": {
          "default": null,
          "description": "Restrict to this owner/repo, plugin@marketplace, or manual.",
          "type": [
            "string",
            "null"
          ]
        },
        "timings": {
          "default": false,
          "description": "Include per-phase timings.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
