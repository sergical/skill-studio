[
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "destination": {
          "default": "universal",
          "description": "`Universal` is the `skills` CLI's pick above. `PerHarness` (`Copy`\nonly) gives every chosen harness a real folder in its own skills\nfolder, Codex, `OpenCode`, and Cursor included, and writes no shared\ncopy; `link_mode` is ignored.",
          "oneOf": [
            {
              "const": "universal",
              "description": "The shared root.",
              "type": "string"
            },
            {
              "const": "per_harness",
              "description": "A harness's own root.",
              "type": "string"
            }
          ]
        },
        "files": {
          "default": [],
          "description": "`Copy` only: the folder's files, staged then swapped into place.",
          "items": {
            "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
            "properties": {
              "contents": {
                "description": "The file's bytes.",
                "items": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "mode": {
                "default": null,
                "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "relative_path": {
                "description": "Path relative to the skill folder's own root.",
                "type": "string"
              }
            },
            "required": [
              "relative_path",
              "contents"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "harnesses": {
          "default": [],
          "description": "The harness set to install for, as the `skills` CLI's `--agent` list:\nharness ids plus the pseudo id `universal` for the shared\n`.agents/skills` folder alone. Empty means `universal` only. Codex,\n`OpenCode`, Cursor, and `universal` read the shared folder; Claude\nCode, pi, and Grok Build get their own folder (see `link_mode`).",
          "items": {
            "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
            "type": "string"
          },
          "type": "array"
        },
        "link_mode": {
          "default": "link",
          "description": "How each chosen harness with its own folder receives the skill. See\n[`InstallLinkMode`].",
          "oneOf": [
            {
              "const": "link",
              "description": "One real folder at `<scope>/.agents/skills/<name>`, and a relative\nsymlink to it in each other chosen harness folder.",
              "type": "string"
            },
            {
              "const": "copy",
              "description": "One real folder in each chosen harness folder. The shared folder\ngets one only when a harness that reads it is chosen.",
              "type": "string"
            }
          ]
        },
        "method": {
          "description": "Which method writes the bytes.",
          "oneOf": [
            {
              "const": "copy",
              "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
              "type": "string"
            },
            {
              "const": "dotagents",
              "description": "`npx -y @sentry/dotagents add <source>`.",
              "type": "string"
            },
            {
              "const": "skills_sh",
              "description": "`npx -y skills add <source>`.",
              "type": "string"
            }
          ]
        },
        "save_as_preference": {
          "default": true,
          "description": "Saves this call's method and harnesses as the preference\n`install_preferences` returns for the next install. Defaults to\n`true` so a caller opts out, not in.",
          "type": "boolean"
        },
        "scope": {
          "description": "`Global` installs under the scope home; `Project` installs under one\nproject.",
          "oneOf": [
            {
              "description": "Under the scope home.",
              "properties": {
                "scope": {
                  "const": "global",
                  "type": "string"
                }
              },
              "required": [
                "scope"
              ],
              "type": "object"
            },
            {
              "description": "Under one tracked project.",
              "properties": {
                "project": {
                  "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
                  "type": "string",
                  "x-untrusted": true
                },
                "scope": {
                  "const": "project",
                  "type": "string"
                }
              },
              "required": [
                "scope",
                "project"
              ],
              "type": "object"
            }
          ]
        },
        "skill": {
          "description": "The folder name the skill will be installed under, both at\n`.agents/skills/<name>` and, for `Dotagents`/`SkillsSh`, the name the\nCLI is expected to create.",
          "type": "string",
          "x-untrusted": true
        },
        "source": {
          "default": null,
          "description": "`Dotagents`/`SkillsSh` only: the source argument passed to the CLI's\n`add` command (for example `owner/repo`).",
          "type": [
            "string",
            "null"
          ]
        },
        "trust_confirmed": {
          "default": false,
          "description": "Confirms the trust prompt for `trust_identity`. A first call with\nthis `false` against an untrusted identity returns\n[`InstallOutcome::NeedsTrust`] instead of writing.",
          "type": "boolean"
        },
        "trust_identity": {
          "default": null,
          "description": "The source's normalized repository identity, for the trust check\n(`None` for a source the policy never gates, like a local path).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "skill",
        "method",
        "scope"
      ],
      "type": "object"
    },
    "name": "add"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "mode": {
          "description": "Chosen mode; must be in `preview.allowed_apply_modes`.",
          "oneOf": [
            {
              "const": "apply-fix",
              "description": "Rewrite the file in place.",
              "type": "string"
            },
            {
              "const": "fix-installed-copy",
              "description": "Rewrite the installed copy that a ledger owns.",
              "type": "string"
            },
            {
              "const": "fork-and-fix",
              "description": "Fork first, then rewrite the fork.",
              "type": "string"
            }
          ]
        },
        "preview": {
          "description": "The preview to apply, unchanged.",
          "properties": {
            "allowed_apply_modes": {
              "description": "Modes the caller may choose from.",
              "items": {
                "description": "Ways a frontmatter repair may be applied.",
                "oneOf": [
                  {
                    "const": "apply-fix",
                    "description": "Rewrite the file in place.",
                    "type": "string"
                  },
                  {
                    "const": "fix-installed-copy",
                    "description": "Rewrite the installed copy that a ledger owns.",
                    "type": "string"
                  },
                  {
                    "const": "fork-and-fix",
                    "description": "Fork first, then rewrite the fork.",
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            "deployment_id": {
              "description": "Target deployment.",
              "type": "string"
            },
            "diff": {
              "description": "Unified diff for a person.",
              "type": "string",
              "x-untrusted": true
            },
            "expected_fingerprint": {
              "description": "Fingerprint of the current `SKILL.md` bytes.",
              "type": "string"
            },
            "managed_update_warning": {
              "description": "Warning shown for [`RepairApplyMode::FixInstalledCopy`]: the next\nmanaged update overwrites the fix.",
              "type": [
                "string",
                "null"
              ],
              "x-untrusted": true
            },
            "original_content": {
              "description": "Current `SKILL.md` text, for a side-by-side view.",
              "type": "string",
              "x-untrusted": true
            },
            "owner_id": {
              "anyOf": [
                {
                  "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Owner at preview time."
            },
            "owner_kind": {
              "description": "Owner kind at preview time.",
              "oneOf": [
                {
                  "const": "skills_sh",
                  "description": "`~/.agents/.skill-lock.json`.",
                  "type": "string"
                },
                {
                  "const": "dotagents",
                  "description": "A dotagents ledger.",
                  "type": "string"
                },
                {
                  "const": "copy",
                  "description": "A copy install recorded by Skill Studio.",
                  "type": "string"
                },
                {
                  "const": "fork",
                  "description": "A fork recorded by Skill Studio.",
                  "type": "string"
                },
                {
                  "const": "plugin",
                  "description": "A harness plugin cache.",
                  "type": "string"
                },
                {
                  "const": "in_repo",
                  "description": "Committed in the project repository.",
                  "type": "string"
                },
                {
                  "const": "manual",
                  "description": "Placed by hand.",
                  "type": "string"
                },
                {
                  "const": "wildcard_dotagents",
                  "description": "A dotagents wildcard entry.",
                  "type": "string"
                },
                {
                  "const": "ambiguous",
                  "description": "More than one ledger claims the name.",
                  "type": "string"
                }
              ]
            },
            "path": {
              "description": "Absolute path of `SKILL.md`.",
              "type": "string",
              "x-untrusted": true
            },
            "proposal_id": {
              "description": "Proposal id.",
              "type": "string"
            },
            "proposed_content": {
              "description": "Proposed `SKILL.md` text, for a side-by-side view.",
              "type": "string",
              "x-untrusted": true
            },
            "proposed_fingerprint": {
              "description": "Fingerprint of the proposed bytes.",
              "type": "string"
            },
            "reason": {
              "description": "Why the repair is proposed, for a person (the spec rule that fails).",
              "type": "string",
              "x-untrusted": true
            },
            "scope": {
              "description": "Scope of the deployment's root.",
              "oneOf": [
                {
                  "description": "Under the scope home.",
                  "properties": {
                    "scope": {
                      "const": "global",
                      "type": "string"
                    }
                  },
                  "required": [
                    "scope"
                  ],
                  "type": "object"
                },
                {
                  "description": "Under one tracked project.",
                  "properties": {
                    "project": {
                      "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
                      "type": "string",
                      "x-untrusted": true
                    },
                    "scope": {
                      "const": "project",
                      "type": "string"
                    }
                  },
                  "required": [
                    "scope",
                    "project"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "proposal_id",
            "deployment_id",
            "path",
            "scope",
            "reason",
            "owner_kind",
            "expected_fingerprint",
            "proposed_fingerprint",
            "original_content",
            "proposed_content",
            "diff",
            "allowed_apply_modes"
          ],
          "type": "object"
        }
      },
      "required": [
        "preview",
        "mode"
      ],
      "type": "object"
    },
    "name": "apply_frontmatter_repair"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "copy_status": {
          "anyOf": [
            {
              "description": "How an agent copy compares with the library copy in its scope.",
              "oneOf": [
                {
                  "const": "link",
                  "description": "A link that resolves to the library copy.",
                  "type": "string"
                },
                {
                  "const": "same",
                  "description": "A real folder with the same files as the library copy.",
                  "type": "string"
                },
                {
                  "const": "differs",
                  "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
                  "type": "string"
                },
                {
                  "const": "stale",
                  "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keep only the agent copies with this copy status."
        },
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root": {
          "anyOf": [
            {
              "description": "A scan root filter.",
              "oneOf": [
                {
                  "const": "library",
                  "description": "Skills directly in ~/.agents/skills.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to the global shared library folder."
        },
        "skills": {
          "default": [],
          "description": "Restrict to these skill names; empty means all.",
          "items": {
            "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
            "type": "string",
            "x-untrusted": true
          },
          "type": "array"
        },
        "source": {
          "default": null,
          "description": "Restrict to this owner/repo, plugin@marketplace, or manual.",
          "type": [
            "string",
            "null"
          ]
        },
        "timings": {
          "default": false,
          "description": "Include per-phase timings.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "diagnose"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
