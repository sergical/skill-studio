          "description": "Installed skill name.",
          "type": "string"
        }
      },
      "required": [
        "skill"
      ],
      "type": "object"
    },
    "name": "review_set"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "copy_status": {
          "anyOf": [
            {
              "description": "How an agent copy compares with the library copy in its scope.",
              "oneOf": [
                {
                  "const": "link",
                  "description": "A link that resolves to the library copy.",
                  "type": "string"
                },
                {
                  "const": "same",
                  "description": "A real folder with the same files as the library copy.",
                  "type": "string"
                },
                {
                  "const": "differs",
                  "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
                  "type": "string"
                },
                {
                  "const": "stale",
                  "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keep only the agent copies with this copy status."
        },
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root": {
          "anyOf": [
            {
              "description": "A scan root filter.",
              "oneOf": [
                {
                  "const": "library",
                  "description": "Skills directly in ~/.agents/skills.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to the global shared library folder."
        },
        "skills": {
          "default": [],
          "description": "Restrict to these skill names; empty means all.",
          "items": {
            "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
            "type": "string",
            "x-untrusted": true
          },
          "type": "array"
        },
        "source": {
          "default": null,
          "description": "Restrict to this owner/repo, plugin@marketplace, or manual.",
          "type": [
            "string",
            "null"
          ]
        },
        "timings": {
          "default": false,
          "description": "Include per-phase timings.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "scan"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "days": {
          "default": null,
          "description": "How many days back to count uses. Default 30.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "harness": {
          "default": null,
          "description": "Keep uses from this harness id only.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "Keep uses with this recorded project path only.",
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "default": null,
          "description": "Count uses from this date (YYYY-MM-DD or RFC 3339) instead of `days`.",
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "default": null,
          "description": "Keep only the N most used skills.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "until": {
          "default": null,
          "description": "Count uses before this date (YYYY-MM-DD or RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "skill_usage"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "deployment_id": {
          "description": "The Universal deployment to split.",
          "type": "string"
        },
        "harnesses": {
          "description": "The harnesses that keep the skill. Must not be empty.",
          "items": {
            "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "deployment_id",
        "harnesses"
      ],
      "type": "object"
    },
    "name": "split"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agent": {
          "description": "The agent that loses the skill. Must read the shared folder.",
          "type": "string"
        },
        "deployment_id": {
          "description": "The live Universal (shared folder) copy, at global or project scope.",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "agent"
      ],
      "type": "object"
    },
    "name": "turn_off_check"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agent": {
          "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "description": "Confirm splitting the shared skill and stopping source updates for its copies.",
          "type": "boolean"
        },
        "deployment_id": {
          "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "agent"
      ],
      "type": "object"
    },
    "name": "turn_off_for_agent"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "anyOf": [
            {
              "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One copy to change. Cannot be used with skills."
        },
        "skills": {
          "description": "Up to 100 names to change together. All names are checked before any move.",
          "items": {
            "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
            "type": "string",
            "x-untrusted": true
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "unpark"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "files": {
          "default": [],
          "description": "`Copy` only: the fresh files to stage and swap in.",
          "items": {
            "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
            "properties": {
              "contents": {
                "description": "The file's bytes.",
                "items": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "mode": {
                "default": null,
                "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "relative_path": {
                "description": "Path relative to the skill folder's own root.",
                "type": "string"
              }
            },
            "required": [
              "relative_path",
              "contents"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "method": {
          "description": "Which method wrote the deployment being refreshed.",
          "oneOf": [
            {
              "const": "copy",
              "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
              "type": "string"
            },
            {
              "const": "dotagents",
              "description": "`npx -y @sentry/dotagents add <source>`.",
              "type": "string"
            },
            {
              "const": "skills_sh",
              "description": "`npx -y skills add <source>`.",
              "type": "string"
            }
          ]
        },
        "ref_pin": {
          "default": null,
          "description": "`Dotagents` only: an already-resolved commit for a pinned\n(`declared_ref`) ledger entry - the caller's own concern, not\nre-derived here (see `ops_update`'s module doc). The update writes it\ninto that entry's `ref` before running `dotagents install`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "`Global` updates the scope home; `Project` updates one project.",
          "oneOf": [
            {
              "description": "Under the scope home.",
              "properties": {
                "scope": {
                  "const": "global",
                  "type": "string"
                }
              },
              "required": [
                "scope"
              ],
              "type": "object"
            },
            {
              "description": "Under one tracked project.",
              "properties": {
                "project": {
                  "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
                  "type": "string",
                  "x-untrusted": true
                },
                "scope": {
                  "const": "project",
                  "type": "string"
                }
              },
              "required": [
                "scope",
                "project"
              ],
              "type": "object"
            }
          ]
        },
        "skill": {
          "description": "The already-installed skill's folder name.",
          "type": "string",
          "x-untrusted": true
        },
        "source": {
          "default": null,
          "description": "`Dotagents` only: must be present, but no longer reaches the CLI -\nthe update runs `dotagents install`, which reads the source from the\nscope's `agents.toml` entry (see `ops_update`'s module doc).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "skill",
        "method",
        "scope"
      ],
      "type": "object"
    },
    "name": "update"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "requests": {
          "description": "One request per skill to refresh, each its own journal entry; at most 100.",
          "items": {
            "description": "Request to refresh one already-installed skill in place, via\n`ops::update`. Reuses [`InstallMethod`]: `Copy` re-stages fresh `files`\nand swaps them in, quarantining the previous tree; `Dotagents`/`SkillsSh`\nre-run the same CLI `install` shelled out to, in place over the existing\ndestination.",
            "properties": {
              "files": {
                "default": [],
                "description": "`Copy` only: the fresh files to stage and swap in.",
                "items": {
                  "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
                  "properties": {
                    "contents": {
                      "description": "The file's bytes.",
                      "items": {
                        "format": "uint8",
                        "maximum": 255,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "mode": {
                      "default": null,
                      "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "relative_path": {
                      "description": "Path relative to the skill folder's own root.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "relative_path",
                    "contents"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "method": {
                "description": "Which method wrote the deployment being refreshed.",
                "oneOf": [
                  {
                    "const": "copy",
                    "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
                    "type": "string"
                  },
                  {
                    "const": "dotagents",
                    "description": "`npx -y @sentry/dotagents add <source>`.",
                    "type": "string"
                  },
                  {
                    "const": "skills_sh",
                    "description": "`npx -y skills add <source>`.",
                    "type": "string"
                  }
                ]
              },
              "ref_pin": {
                "default": null,
                "description": "`Dotagents` only: an already-resolved commit for a pinned\n(`declared_ref`) ledger entry - the caller's own concern, not\nre-derived here (see `ops_update`'s module doc). The update writes it\ninto that entry's `ref` before running `dotagents install`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {
                "description": "`Global` updates the scope home; `Project` updates one project.",
                "oneOf": [
                  {
                    "description": "Under the scope home.",
                    "properties": {
                      "scope": {
                        "const": "global",
                        "type": "string"
                      }
                    },
                    "required": [
                      "scope"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "Under one tracked project.",
                    "properties": {
                      "project": {
                        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
                        "type": "string",
                        "x-untrusted": true
                      },
                      "scope": {
                        "const": "project",
                        "type": "string"
                      }
                    },
                    "required": [
                      "scope",
                      "project"
                    ],
                    "type": "object"
                  }
                ]
              },
              "skill": {
                "description": "The already-installed skill's folder name.",
                "type": "string",
                "x-untrusted": true
              },
              "source": {
                "default": null,
                "description": "`Dotagents` only: must be present, but no longer reaches the CLI -\nthe update runs `dotagents install`, which reads the source from the\nscope's `agents.toml` entry (see `ops_update`'s module doc).",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "skill",
              "method",
              "scope"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "requests"
      ],
      "type": "object"
    },
    "name": "update_all"
  }
]
