          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "doctor"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
