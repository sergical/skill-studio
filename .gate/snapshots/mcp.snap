            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "extras"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "skill": {
          "description": "Skill to run the doctor checks and repairs for.",
          "type": "string",
          "x-untrusted": true
        }
      },
      "required": [
        "skill"
      ],
      "type": "object"
    },
    "name": "fix"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "deployment_id": {
          "anyOf": [
            {
              "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Desktop edits one exact copy."
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "policy": {
          "anyOf": [
            {
              "description": "The three invocation-control states a skill's frontmatter can express.",
              "oneOf": [
                {
                  "const": "both",
                  "description": "Both explicit (`/name`) and model auto-invoke are available.",
                  "type": "string"
                },
                {
                  "const": "user-only",
                  "description": "`disable-model-invocation: true` - explicit invocation only.",
                  "type": "string"
                },
                {
                  "const": "model-only",
                  "description": "`user-invocable: false` - model auto-invoke only.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent checks only. A policy writes all copies of the named skill."
        },
        "skill": {
          "anyOf": [
            {
              "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
              "type": "string",
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ],
          "description": "Name filter; required for writes."
        }
      },
      "type": "object"
    },
    "name": "invocation"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "invocation_mismatches"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "all": {
          "default": false,
          "description": "Include skills outside the shared library.",
          "type": "boolean"
        },
        "copy_status": {
          "anyOf": [
            {
              "description": "Copy severity, from a link to a changed independent folder.",
              "oneOf": [
                {
                  "const": "link",
                  "description": "Resolves to the library.",
                  "type": "string"
                },
                {
                  "const": "same",
                  "description": "Matches the library's files.",
                  "type": "string"
                },
                {
                  "const": "old",
                  "description": "Missed the library's last update.",
                  "type": "string"
                },
                {
                  "const": "changed",
                  "description": "Has independent changes.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keep rows with this agent copy status."
        },
        "count_by": {
          "default": null,
          "description": "Count the rows of the whole main list by this field. A list field\ncounts each item.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "A `next_cursor` from `page` or `page.also` of an earlier call with the\nsame filters. It continues that one list; the other lists return only\ntotals.",
          "type": [
            "string",
            "null"
          ]
        },
        "days": {
          "default": null,
          "description": "Rolling window in days; defaults to 30.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fields": {
          "default": [],
          "description": "Row fields to keep. Empty keeps every field.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": null,
          "description": "Rows to return from the main list. `0` returns only `page` (totals\nand `counts`). Without it, rows until the answer is 32 KB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modes": {
          "additionalProperties": {
            "description": "Effective model invocation support for one harness.",
            "oneOf": [
              {
                "const": "manual",
                "description": "Only explicit invocation.",
                "type": "string"
              },
              {
                "const": "auto",
                "description": "Model invocation is allowed.",
                "type": "string"
              },
              {
                "const": "unsupported",
                "description": "No verified skill-owned control.",
                "type": "string"
              }
            ]
          },
          "default": {},
          "description": "Keep rows that each named agent (`claude-code`, `codex`, ...) reads\nin the given mode.",
          "type": "object"
        },
        "since": {
          "default": null,
          "description": "Inclusive start (YYYY-MM-DD or RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "default": [],
          "description": "Restrict to these skill names; empty means all.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort": {
          "anyOf": [
            {
              "description": "Supported library row order.",
              "oneOf": [
                {
                  "const": "name",
                  "description": "Alphabetical skill names.",
                  "type": "string"
                },
                {
                  "const": "uses",
                  "description": "Most uses first, then name.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort by name (default) or uses descending."
        },
        "source": {
          "default": null,
          "description": "Restrict to owner/repo, plugin@marketplace, or manual.",
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "default": null,
          "description": "Keep the N most used skills.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "until": {
          "default": null,
          "description": "Exclusive end (YYYY-MM-DD or RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "library"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "after": {
          "anyOf": [
            {
              "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pagination cursor: return only rows older than this event. Pass the\nlast id of the previous page. Ids are ULIDs, so \"older\" is \"sorts\nbefore\"."
        },
        "check_drift": {
          "default": false,
          "description": "Compare live fingerprints with the recorded ones and fill `drift`.\nCosts one read per touched path; `false` leaves `Unchecked`.",
          "type": "boolean"
        },
        "limit": {
          "default": 0,
          "description": "Maximum rows; `0` means the core default.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
              "type": "string",
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to one skill."
        }
      },
      "type": "object"
    },
    "name": "list_events"
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "copy_status": {
          "anyOf": [
            {
              "description": "How an agent copy compares with the library copy in its scope.",
              "oneOf": [
                {
                  "const": "link",
                  "description": "A link that resolves to the library copy.",
                  "type": "string"
                },
                {
                  "const": "same",
                  "description": "A real folder with the same files as the library copy.",
                  "type": "string"
                },
                {
                  "const": "differs",
                  "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
                  "type": "string"
                },
                {
                  "const": "stale",
                  "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keep only the agent copies with this copy status."
