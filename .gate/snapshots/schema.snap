{
  "crates/skill-studio-core/schema/agent_off_check.schema.json": {
    "$defs": {
      "AgentOffRefusal": {
        "description": "Why `turn_off_for_agent` would write nothing.",
        "properties": {
          "off_everywhere": {
            "description": "True when parking the shared copy for every agent is the way out.",
            "type": "boolean"
          },
          "reason": {
            "description": "One plain line a person can act on.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "reason",
          "off_everywhere"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `turn_off_check`: what to show before the user confirms.",
    "properties": {
      "git_tracked": {
        "description": "The shared folder's `park_check` answer: git tracks it, so the move\nshows as deleted files. `None` when git could not be asked.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "project": {
        "description": "The project the copy belongs to, when it is a project copy.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "refusal": {
        "anyOf": [
          {
            "$ref": "#/$defs/AgentOffRefusal"
          },
          {
            "type": "null"
          }
        ],
        "description": "Set when `turn_off_for_agent` would refuse."
      }
    },
    "title": "AgentOffCheck",
    "type": "object"
  },
  "crates/skill-studio-core/schema/agent_off_outcome.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "SplitCopy": {
        "description": "One folder `split` wrote.",
        "properties": {
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "The harness that reads this copy."
          },
          "path": {
            "description": "The copy's folder.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "harness",
          "path"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `turn_off_for_agent`.",
    "properties": {
      "agent": {
        "$ref": "#/$defs/AgentIdentity",
        "description": "The agent the skill is now off for."
      },
      "copies": {
        "description": "One entry per agent that got its own copy, including `agent`.",
        "items": {
          "$ref": "#/$defs/SplitCopy"
        },
        "type": "array"
      },
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The Universal deployment that was split."
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The one event Activity can undo: it puts the shared folder back and\nremoves the per-agent copies and the parked copy."
      },
      "parked_path": {
        "description": "Where `agent`'s copy now lives, under the parked root.",
        "type": "string",
        "x-untrusted": true
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The skill's name."
      },
      "update_note": {
        "description": "Plain-language note: `npx skills update` updates only a Universal\ncopy, so these copies no longer get updates from it.",
        "type": "string"
      }
    },
    "required": [
      "event_id",
      "deployment_id",
      "skill",
      "agent",
      "copies",
      "parked_path",
      "update_note"
    ],
    "title": "AgentOffOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/agent_off_request.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to turn a skill in the shared folder off for one agent: give every\nagent that reads the folder its own copy, then park that agent's copy.",
    "properties": {
      "agent": {
        "$ref": "#/$defs/AgentIdentity",
        "description": "The agent that loses the skill. Must read the shared folder."
      },
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The live Universal (shared folder) copy, at global or project scope."
      }
    },
    "required": [
      "deployment_id",
      "agent"
    ],
    "title": "AgentOffRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/capabilities.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "CapabilityReport": {
        "description": "Answer to the `capabilities` operation for one harness.",
        "properties": {
          "default_install_destinations": {
            "description": "Roots an install picker may offer as a destination: the universal\nroot, plus a harness's own root only when the catalog has it\nverified from the vendor's own documentation ([`Confidence::VerifiedFromDocs`]).\nAn [`RootRole::Own`] root the catalog only infers (Codex's\n`.codex/skills`: `docs/agent-skill-conventions.md`, \"Resolved by\nthe docs on 2026-09-16\") is excluded - installing there would be a\nguess about where Codex actually looks.",
            "items": {
              "$ref": "#/$defs/RootSpec"
            },
            "type": "array"
          },
          "discovery": {
            "description": "Roots the scanner will visit for this harness.",
            "items": {
              "$ref": "#/$defs/RootSpec"
            },
            "type": "array"
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Harness."
          },
          "native_disable": {
            "anyOf": [
              {
                "$ref": "#/$defs/NativeDisableSpec"
              },
              {
                "type": "null"
              }
            ],
            "description": "Native disable facts."
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/HarnessObserved"
              },
              {
                "type": "null"
              }
            ],
            "description": "Machine facts, when the caller asked for them."
          },
          "operations": {
            "description": "Per-operation support derived from the facts.",
            "items": {
              "$ref": "#/$defs/OperationSupport"
            },
            "type": "array"
          },
          "runtime_notes": {
            "description": "Notes for a person (unverified rows, open issues).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "harness",
          "discovery",
          "default_install_destinations",
          "operations",
          "runtime_notes"
        ],
        "type": "object"
      },
      "Confidence": {
        "description": "How sure the catalog is about a fact.",
        "oneOf": [
          {
            "const": "verified-from-docs",
            "description": "Read from the vendor's documentation or repository.",
            "type": "string"
          },
          {
            "const": "inferred",
            "description": "Derived from a secondary source or an issue thread.",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "Not found in any primary source.",
            "type": "string"
          }
        ]
      },
      "DisableMechanism": {
        "description": "Native switch a harness offers to hide one skill.",
        "oneOf": [
          {
            "const": "claude_skill_overrides",
            "description": "Claude Code `settings.json` `skillOverrides`.",
            "type": "string"
          },
          {
            "const": "codex_skills_config",
            "description": "Codex `config.toml` `[[skills.config]]`.",
            "type": "string"
          },
          {
            "const": "opencode_permission",
            "description": "`OpenCode` reads V1 `permission.skill` and V2 `permissions[]` skill\nrules; Skill Studio writes the V1 `permission.skill.<name> = \"deny\"`\nkey (`opencode_config.rs`'s module doc comment has the source\ncitation for both shapes). `opencode.jsonc` is detected but never\nwritten.",
            "type": "string"
          },
          {
            "const": "pi_settings",
            "description": "pi `settings.json` `skills` exclusions (`!pattern`, `-path`), also\nwritten by `pi config`.",
            "type": "string"
          },
          {
            "const": "claude_link_removed",
            "description": "Skill Studio removes the per-skill link under `~/.claude/skills`.",
            "type": "string"
          },
          {
            "const": "studio_moved",
            "description": "Skill Studio moves the folder into `.skill-studio-disabled`.",
            "type": "string"
          }
        ]
      },
      "DisabledBy": {
        "description": "Why a deployment is off, as shown to the user.\n\nInvariant: the first four names match the desktop wire today; the last\ntwo are new and only appear once the matching mechanism is supported.",
        "oneOf": [
          {
            "const": "codex-config",
            "description": "Codex `[[skills.config]] enabled = false`.",
            "type": "string"
          },
          {
            "const": "opencode-permission",
            "description": "`OpenCode` `permission.skill` deny.",
            "type": "string"
          },
          {
            "const": "claude-link-removed",
            "description": "The Claude Code per-skill link was removed.",
            "type": "string"
          },
          {
            "const": "studio-moved",
            "description": "Skill Studio moved the folder aside.",
            "type": "string"
          },
          {
            "const": "claude-skill-overrides",
            "description": "Claude Code `skillOverrides` set to `off`.",
            "type": "string"
          },
          {
            "const": "pi-settings",
            "description": "pi per-skill toggle.",
            "type": "string"
          }
        ]
      },
      "Evidence": {
        "description": "Where a fact comes from.",
        "properties": {
          "confidence": {
            "$ref": "#/$defs/Confidence",
            "description": "Confidence level."
          },
          "source": {
            "description": "URL or document reference.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "confidence"
        ],
        "type": "object"
      },
      "HarnessObserved": {
        "description": "Facts observed on this machine, as opposed to documented facts.",
        "properties": {
          "config_present": {
            "description": "The native config file exists.",
            "type": "boolean"
          },
          "config_writable": {
            "$ref": "#/$defs/Support",
            "description": "The native config file can be written (parsed and not `.jsonc`)."
          },
          "runner_binary": {
            "description": "Resolved runner binary, when found on `PATH`.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          }
        },
        "required": [
          "config_present",
          "config_writable"
        ],
        "type": "object"
      },
      "NativeDisableSpec": {
        "description": "Native disable facts for one harness.",
        "properties": {
          "disabled_by": {
            "$ref": "#/$defs/DisabledBy",
            "description": "Value reported on a disabled deployment."
          },
          "evidence": {
            "$ref": "#/$defs/Evidence",
            "description": "Evidence for the mechanism."
          },
          "mechanism": {
            "$ref": "#/$defs/DisableMechanism",
            "description": "The switch."
          },
          "scopes": {
            "description": "Scope levels the switch works at.",
            "items": {
              "$ref": "#/$defs/ScopeLevel"
            },
            "type": "array"
          },
          "writable": {
            "$ref": "#/$defs/Support",
            "description": "Whether Skill Studio can write the switch safely."
          }
        },
        "required": [
          "mechanism",
          "scopes",
          "writable",
          "disabled_by",
          "evidence"
        ],
        "type": "object"
      },
      "OperationSupport": {
        "description": "Support for one core operation on one harness.",
        "properties": {
          "operation": {
            "description": "Operation name, as used in the envelope.",
            "type": "string"
          },
          "support": {
            "$ref": "#/$defs/Support",
            "description": "Support."
          }
        },
        "required": [
          "operation",
          "support"
        ],
        "type": "object"
      },
      "RootRole": {
        "description": "Role of a root the harness reads.",
        "oneOf": [
          {
            "const": "own",
            "description": "The harness's own skills directory.",
            "type": "string"
          },
          {
            "const": "universal",
            "description": "The shared `.agents/skills` root.",
            "type": "string"
          },
          {
            "const": "legacy",
            "description": "A legacy directory still read for compatibility.",
            "type": "string"
          },
          {
            "const": "plugin_cache",
            "description": "A plugin cache that ships skills.",
            "type": "string"
          },
          {
            "const": "cross_harness",
            "description": "A root another harness owns that this harness also reads.",
            "type": "string"
          }
        ]
      },
      "RootSpec": {
        "description": "One root a harness reads.",
        "properties": {
          "evidence": {
            "$ref": "#/$defs/Evidence",
            "description": "Evidence."
          },
          "level": {
            "$ref": "#/$defs/ScopeLevel",
            "description": "Global or project."
          },
          "recursive": {
            "description": "True when the harness walks subdirectories for `SKILL.md`.",
            "type": "boolean"
          },
          "relative_path": {
            "description": "Path relative to the home or the project.",
            "type": "string"
          },
          "role": {
            "$ref": "#/$defs/RootRole",
            "description": "Role."
          }
        },
        "required": [
          "level",
          "relative_path",
          "role",
          "recursive",
          "evidence"
        ],
        "type": "object"
      },
      "ScopeLevel": {
        "description": "Global (`~`) or project scope level.",
        "oneOf": [
          {
            "const": "global",
            "description": "Under the home root.",
            "type": "string"
          },
          {
            "const": "project",
            "description": "Under a project root.",
            "type": "string"
          }
        ]
      },
      "Support": {
        "description": "Whether a harness supports one capability.\n\nInvariant: `Unknown` carries no evidence and is never treated as `No`.\nAn operation that needs a `Yes` refuses on `Unknown` with\n[`crate::error::ErrorCode::Unsupported`] and names the missing evidence.",
        "oneOf": [
          {
            "description": "Supported.",
            "properties": {
              "evidence": {
                "$ref": "#/$defs/Evidence"
              },
              "support": {
                "const": "yes",
                "type": "string"
              }
            },
            "required": [
              "support",
              "evidence"
            ],
            "type": "object"
          },
          {
            "description": "Not supported.",
            "properties": {
              "evidence": {
                "$ref": "#/$defs/Evidence"
              },
              "support": {
                "const": "no",
                "type": "string"
              }
            },
            "required": [
              "support",
              "evidence"
            ],
            "type": "object"
          },
          {
            "description": "Supported with limits described in the evidence source.",
            "properties": {
              "evidence": {
                "$ref": "#/$defs/Evidence"
              },
              "support": {
                "const": "partial",
                "type": "string"
              }
            },
            "required": [
              "support",
              "evidence"
            ],
            "type": "object"
          },
          {
            "description": "No primary source found.",
            "properties": {
              "support": {
                "const": "unknown",
                "type": "string"
              }
            },
            "required": [
              "support"
            ],
            "type": "object"
          }
        ]
      },
      "ToolAvailability": {
        "description": "Whether one executable was found on `PATH`.",
        "properties": {
          "name": {
            "description": "Name as requested (`npx`, `dotagents`, `gh`).",
            "type": "string"
          },
          "path": {
            "description": "Resolved path, `None` when the tool is absent.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of the `capabilities` operation.",
    "properties": {
      "harnesses": {
        "description": "One report per requested harness, in catalog order.",
        "items": {
          "$ref": "#/$defs/CapabilityReport"
        },
        "type": "array"
      },
      "tools": {
        "description": "Tools the caller asked about, in request order. Empty unless the\nrequest named tools and a [`crate::ports::ToolLookup`] port exists.",
        "items": {
          "$ref": "#/$defs/ToolAvailability"
        },
        "type": "array"
      }
    },
    "required": [
      "harnesses",
      "tools"
    ],
    "title": "Capabilities",
    "type": "object"
  },
  "crates/skill-studio-core/schema/capabilities_request.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `capabilities`.",
    "properties": {
      "harnesses": {
        "default": [],
        "description": "Restrict to these harnesses; empty means all. A name without a\ncatalog row is `invalid_request`.",
        "items": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "type": "array"
      },
      "observe": {
        "default": false,
        "description": "Also probe the machine (config presence, runner binary).",
        "type": "boolean"
      },
      "tools": {
        "default": [],
        "description": "Executables to look up on `PATH` (`npx`, `dotagents`, `gh`). Needs\nthe `ToolLookup` port; without it a non-empty list is `unsupported`.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "title": "CapabilitiesRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/conflict_report.schema.json": {
    "$defs": {
      "ConflictSummary": {
        "description": "One pair of differing copies: never merged, named for the caller to open\nside by side in the user's editor.",
        "properties": {
          "message": {
            "description": "One-line summary for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "path_a": {
            "description": "First copy's path.",
            "type": "string",
            "x-untrusted": true
          },
          "path_b": {
            "description": "Second copy's path.",
            "type": "string",
            "x-untrusted": true
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "Skill the conflict belongs to."
          }
        },
        "required": [
          "skill",
          "message",
          "path_a",
          "path_b"
        ],
        "type": "object"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `diagnose_conflict`.",
    "properties": {
      "conflicts": {
        "description": "Every conflict found. Read-only: nothing is written.",
        "items": {
          "$ref": "#/$defs/ConflictSummary"
        },
        "type": "array"
      }
    },
    "required": [
      "conflicts"
    ],
    "title": "ConflictReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/diagnose_conflict_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `diagnose_conflict`. Empty: a conflict is a relationship\nbetween two deployments of one skill, found by scanning the whole\ninventory rather than named one deployment at a time.",
    "title": "DiagnoseConflictRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/diagnosis.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "BackingRelationship": {
        "description": "How a deployment is wired to its bytes.",
        "oneOf": [
          {
            "const": "canonical",
            "description": "The directory holds the bytes.",
            "type": "string"
          },
          {
            "const": "linked_to",
            "description": "A symlink to another deployment.",
            "type": "string"
          },
          {
            "const": "independent",
            "description": "A copy that no longer tracks its source.",
            "type": "string"
          }
        ]
      },
      "Completeness": {
        "description": "Whether a scan saw everything it was asked to see.",
        "oneOf": [
          {
            "const": "complete",
            "description": "Every root was read.",
            "type": "string"
          },
          {
            "const": "partial",
            "description": "Some roots were skipped; see `observations`.",
            "type": "string"
          }
        ]
      },
      "CopyStatus": {
        "description": "How an agent copy compares with the library copy in its scope.",
        "oneOf": [
          {
            "const": "link",
            "description": "A link that resolves to the library copy.",
            "type": "string"
          },
          {
            "const": "same",
            "description": "A real folder with the same files as the library copy.",
            "type": "string"
          },
          {
            "const": "differs",
            "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
            "type": "string"
          },
          {
            "const": "stale",
            "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
            "type": "string"
          }
        ]
      },
      "DeploymentDto": {
        "description": "One installed copy or link of a skill.\n\nInvariant: `harness` is an [`AgentId`] or `None` for the universal and\nparked roots; it is never a display string. `plugin` is `Some` exactly\nwhen `root.kind` is [`crate::identity::RootKind::PluginCache`].",
        "properties": {
          "backing": {
            "$ref": "#/$defs/BackingRelationship",
            "description": "How the bytes are backed."
          },
          "content_fingerprint": {
            "anyOf": [
              {
                "$ref": "#/$defs/Fingerprint"
              },
              {
                "type": "null"
              }
            ],
            "description": "Content fingerprint over the directory tree."
          },
          "content_hash": {
            "description": "sha256 over the sorted (relative path, bytes) pairs of the skill\nfolder. Distinct from `content_fingerprint`: a different, whole-folder\nscheme kept for parity with the desktop's `SkillCandidate`.",
            "type": "string"
          },
          "copy_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/CopyStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "For an agent copy, how it compares with the library copy\n(`.agents/skills`) in the same scope. `None` for the library copy,\na plugin or parked copy, a broken link, or an agent copy with no\nlibrary copy."
          },
          "description_tokens": {
            "description": "Token count of just `\"{name}: {description}\"` - the prompt cost the\nmodel actually pays per turn, as opposed to `skill_md_tokens` which\ncounts the whole file.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "destination": {
            "$ref": "#/$defs/SkillDestination",
            "description": "Universal or per-harness."
          },
          "disabled_by": {
            "anyOf": [
              {
                "$ref": "#/$defs/DisabledBy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the deployment is off, when it is."
          },
          "disabled_readers": {
            "description": "Readers of a universal deployment that have it disabled.",
            "items": {
              "$ref": "#/$defs/AgentIdentity"
            },
            "type": "array"
          },
          "file_count": {
            "description": "Total files counted while walking the skill folder.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "folder_bytes": {
            "description": "Total bytes read while walking the skill folder.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "folder_truncated": {
            "description": "True when the folder walk hit the file-count or byte cap and stopped\nearly - `folder_bytes`/`file_count`/`content_hash` are partial.",
            "type": "boolean"
          },
          "frontmatter": {
            "anyOf": [
              {
                "$ref": "#/$defs/SkillFrontmatter"
              },
              {
                "type": "null"
              }
            ],
            "description": "Parsed `SKILL.md` frontmatter, when the file parsed."
          },
          "frontmatter_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Every top-level frontmatter key, stringified.",
            "type": "object",
            "x-untrusted": true
          },
          "harness": {
            "anyOf": [
              {
                "$ref": "#/$defs/AgentIdentity"
              },
              {
                "type": "null"
              }
            ],
            "description": "Harness that owns the root, when it is a harness root."
          },
          "has_spec": {
            "description": "True when the SKILL.md matches the getsentry/skillet spec pattern.",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Opaque id."
          },
          "in_git_repo": {
            "description": "True when the skill's directory sits inside a git working tree (a\n`.git` file or directory on some ancestor). Distinguishes a\nversion-controlled directory from a genuinely unmanaged one - see\n[`SourceKind::InRepo`].",
            "type": "boolean"
          },
          "is_symlink": {
            "description": "True when the deployment's own directory entry is a symlink.",
            "type": "boolean"
          },
          "link_target": {
            "description": "Link target, when the deployment is a symlink.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "modified_at": {
            "description": "RFC3339 of the newest file mtime in the skill folder.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "mutability": {
            "$ref": "#/$defs/DeploymentMutability",
            "description": "Whether writes are allowed."
          },
          "owner_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/OwnerId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Owner id, when a ledger owns it."
          },
          "owner_kind": {
            "$ref": "#/$defs/LifecycleOwnerKind",
            "description": "Which ledger owns the lifecycle."
          },
          "parked_origin": {
            "anyOf": [
              {
                "$ref": "#/$defs/RootRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a parked copy, the root it came from and returns to: the scope\n(with the project path) and `Universal` or the agent's own root.\n`None` for a copy that is not parked."
          },
          "parked_owner_kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/LifecycleOwnerKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a parked copy, the owner type it had before Park, read from the\nslot's origin marker. Provenance only: `owner_kind` still says what\nmanages the parked copy now. `None` for a copy that is not parked or\nwas parked before the marker recorded it."
          },
          "path": {
            "description": "Absolute lexical path of the skill directory.",
            "type": "string",
            "x-untrusted": true
          },
          "plugin": {
            "anyOf": [
              {
                "$ref": "#/$defs/PluginSourceDto"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plugin provenance for a plugin-cache deployment."
          },
          "resolved_path": {
            "description": "Canonicalized directory the deployment resolves to, when that is\nmeaningfully different from `path`. Distinct from `link_target`:\n`link_target` is the symlink's own target, while `resolved_path` is\n`None` for an ordinary directory that canonicalizes to itself or for\na symlink whose target does not resolve.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "root": {
            "$ref": "#/$defs/RootRef",
            "description": "Root the deployment lives in."
          },
          "shared_via_whole_dir_link": {
            "description": "True when the skills root itself is a link into the universal root.",
            "type": "boolean"
          },
          "skill_md_tokens": {
            "description": "Token count of the whole `SKILL.md` file.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "source_kind": {
            "$ref": "#/$defs/SourceKind",
            "description": "Provenance classification, per `apps/desktop`'s\n`provenance::classify_source_kind`."
          },
          "spec_violations": {
            "description": "Spec violations, verbatim messages.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "studio_disabled": {
            "description": "True when this deployment was found inside a root's\n`.skill-studio-disabled/` holding directory. Maps to `disabled_by ==\nSome(DisabledBy::StudioMoved)`.",
            "type": "boolean"
          },
          "symlink_error": {
            "description": "Error reading the symlink target, when one occurred.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "symlink_is_broken": {
            "description": "True when the deployment is a symlink whose target does not resolve.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "root",
          "path",
          "destination",
          "backing",
          "mutability",
          "shared_via_whole_dir_link",
          "is_symlink",
          "symlink_is_broken",
          "owner_kind",
          "disabled_readers",
          "spec_violations",
          "frontmatter_fields",
          "has_spec",
          "folder_bytes",
          "file_count",
          "skill_md_tokens",
          "description_tokens",
          "content_hash",
          "folder_truncated",
          "in_git_repo",
          "studio_disabled",
          "source_kind"
        ],
        "type": "object"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "DeploymentMutability": {
        "description": "Whether Skill Studio may change a deployment in place.",
        "oneOf": [
          {
            "const": "mutable",
            "description": "Writes are allowed.",
            "type": "string"
          },
          {
            "const": "read_only",
            "description": "Plugin caches and managed ledgers: writes are refused.",
            "type": "string"
          }
        ]
      },
      "DisabledBy": {
        "description": "Why a deployment is off, as shown to the user.\n\nInvariant: the first four names match the desktop wire today; the last\ntwo are new and only appear once the matching mechanism is supported.",
        "oneOf": [
          {
            "const": "codex-config",
            "description": "Codex `[[skills.config]] enabled = false`.",
            "type": "string"
          },
          {
            "const": "opencode-permission",
            "description": "`OpenCode` `permission.skill` deny.",
            "type": "string"
          },
          {
            "const": "claude-link-removed",
            "description": "The Claude Code per-skill link was removed.",
            "type": "string"
          },
          {
            "const": "studio-moved",
            "description": "Skill Studio moved the folder aside.",
            "type": "string"
          },
          {
            "const": "claude-skill-overrides",
            "description": "Claude Code `skillOverrides` set to `off`.",
            "type": "string"
          },
          {
            "const": "pi-settings",
            "description": "pi per-skill toggle.",
            "type": "string"
          }
        ]
      },
      "Fingerprint": {
        "description": "Content fingerprint in the `sha256:<hex>` form.\n\nInvariant: the hex is lowercase and 64 characters long. One scheme covers\nfiles, trees, and proposals; the old untyped hex form is parsed on read.",
        "type": "string"
      },
      "InstalledSkillDto": {
        "description": "One skill with all of its deployments.",
        "properties": {
          "deployments": {
            "description": "Deployments in scan order.",
            "items": {
              "$ref": "#/$defs/DeploymentDto"
            },
            "type": "array"
          },
          "description": {
            "description": "Description from the first readable deployment.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "name": {
            "$ref": "#/$defs/SkillName",
            "description": "Name."
          },
          "source": {
            "description": "Upstream owner/repo from the owning ledger, plugin@marketplace for a\nplugin skill, or manual.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "source",
          "name",
          "deployments"
        ],
        "type": "object"
      },
      "Inventory": {
        "description": "Result of `scan`.",
        "properties": {
          "completeness": {
            "$ref": "#/$defs/Completeness",
            "description": "Whether every root was read."
          },
          "lock_only": {
            "default": [],
            "description": "Ledger entries whose skill folder is absent from disk.",
            "items": {
              "$ref": "#/$defs/LockOnlySkill"
            },
            "type": "array"
          },
          "observations": {
            "description": "Notes about skipped roots and other facts.",
            "items": {
              "$ref": "#/$defs/Observation"
            },
            "type": "array"
          },
          "projects": {
            "description": "Projects that were covered, sorted by canonical path.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "skills": {
            "description": "Skills sorted by name.",
            "items": {
              "$ref": "#/$defs/InstalledSkillDto"
            },
            "type": "array"
          },
          "timings": {
            "description": "Phase timings.",
            "items": {
              "$ref": "#/$defs/Timing"
            },
            "type": "array"
          },
          "unread_roots": {
            "default": [],
            "description": "Every path prefix this run could not read: a whole root (a budget\noverrun before the root was reached, or a `read_dir` error on the\nroot itself), or a single skill directory whose `SKILL.md` was\nunreadable within an otherwise-readable root - the set a caller\nmerging this result into a previous one must scope a carried-over\ndeployment to.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          }
        },
        "required": [
          "skills",
          "projects",
          "completeness",
          "observations",
          "timings"
        ],
        "type": "object"
      },
      "Issue": {
        "description": "One diagnosed problem.",
        "properties": {
          "deployment_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeploymentId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Deployment the issue belongs to, when it is deployment-specific."
          },
          "kind": {
            "$ref": "#/$defs/IssueKind",
            "description": "Kind."
          },
          "message": {
            "description": "Message for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "next_action": {
            "$ref": "#/$defs/NextAction",
            "description": "Suggested action."
          },
          "severity": {
            "$ref": "#/$defs/Severity",
            "description": "Severity."
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "Skill the issue belongs to."
          }
        },
        "required": [
          "kind",
          "severity",
          "skill",
          "message",
          "next_action"
        ],
        "type": "object"
      },
      "IssueKind": {
        "description": "Structured issue kind. New kinds may be added; names never change.",
        "oneOf": [
          {
            "const": "broken_link",
            "description": "A symlink whose target is missing.",
            "type": "string"
          },
          {
            "const": "unreadable_link",
            "description": "A link Skill Studio could not read.",
            "type": "string"
          },
          {
            "const": "spec_violation",
            "description": "A spec rule is violated (message says which).",
            "type": "string"
          },
          {
            "const": "repairable_frontmatter",
            "description": "Frontmatter that a repair proposal can fix.",
            "type": "string"
          },
          {
            "const": "drift",
            "description": "Two deployments of one name have different bytes.",
            "type": "string"
          },
          {
            "const": "duplicate",
            "description": "The same name is installed twice in one scope.",
            "type": "string"
          },
          {
            "const": "parked",
            "description": "The deployment is parked.",
            "type": "string"
          },
          {
            "const": "disabled",
            "description": "The deployment is disabled for a reader.",
            "type": "string"
          },
          {
            "const": "root_unreadable",
            "description": "A root could not be read inside the budget.",
            "type": "string"
          }
        ]
      },
      "LifecycleOwnerKind": {
        "description": "Which ledger owns a deployment's lifecycle.",
        "oneOf": [
          {
            "const": "skills_sh",
            "description": "`~/.agents/.skill-lock.json`.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "A dotagents ledger.",
            "type": "string"
          },
          {
            "const": "copy",
            "description": "A copy install recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "A fork recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A harness plugin cache.",
            "type": "string"
          },
          {
            "const": "in_repo",
            "description": "Committed in the project repository.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "Placed by hand.",
            "type": "string"
          },
          {
            "const": "wildcard_dotagents",
            "description": "A dotagents wildcard entry.",
            "type": "string"
          },
          {
            "const": "ambiguous",
            "description": "More than one ledger claims the name.",
            "type": "string"
          }
        ]
      },
      "LockOnlySkill": {
        "description": "A lock entry with no installed folder.",
        "properties": {
          "name": {
            "$ref": "#/$defs/SkillName",
            "description": "Ledger key."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Scope containing the ledger."
          },
          "source": {
            "description": "Recorded upstream, or manual for an adopted local folder.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "source",
          "scope"
        ],
        "type": "object"
      },
      "NextAction": {
        "description": "What the user can do about an issue.",
        "oneOf": [
          {
            "description": "Run `preview_frontmatter_repair` on the deployment.",
            "properties": {
              "action": {
                "const": "preview_repair",
                "type": "string"
              },
              "deployment_id": {
                "$ref": "#/$defs/DeploymentId",
                "description": "Target."
              }
            },
            "required": [
              "action",
              "deployment_id"
            ],
            "type": "object"
          },
          {
            "description": "Remove or relink the broken link.",
            "properties": {
              "action": {
                "const": "repair_link",
                "type": "string"
              },
              "deployment_id": {
                "$ref": "#/$defs/DeploymentId",
                "description": "Target."
              }
            },
            "required": [
              "action",
              "deployment_id"
            ],
            "type": "object"
          },
          {
            "description": "Restore the parked or disabled deployment.",
            "properties": {
              "action": {
                "const": "restore",
                "type": "string"
              },
              "deployment_id": {
                "$ref": "#/$defs/DeploymentId",
                "description": "Target."
              }
            },
            "required": [
              "action",
              "deployment_id"
            ],
            "type": "object"
          },
          {
            "description": "Scan again when the root is readable, or with no scan budget.",
            "properties": {
              "action": {
                "const": "rescan",
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          },
          {
            "description": "No automatic action exists.",
            "properties": {
              "action": {
                "const": "none",
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          }
        ]
      },
      "Observation": {
        "description": "Something worth telling the caller that is not an error.",
        "properties": {
          "message": {
            "description": "Message for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "root": {
            "anyOf": [
              {
                "$ref": "#/$defs/RootRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Root the observation is about, when there is one."
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "OwnerId": {
        "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
        "type": "string"
      },
      "PluginSourceDto": {
        "description": "Where a plugin-cache deployment came from, per the agent-plugins.org\nmanifest convention (`<cache>/<marketplace>/<plugin>/<version>/skills/`).",
        "properties": {
          "enabled": {
            "description": "Claude Code's `enabledPlugins[\"<plugin>@<marketplace>\"]` state:\n`Some(false)` when the harness has the plugin switched off,\n`Some(true)` when switched on, `None` when the harness records\nnothing for it (including every non-Claude-Code harness).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "marketplace": {
            "description": "Marketplace directory name.",
            "type": "string"
          },
          "plugin": {
            "description": "Plugin directory name.",
            "type": "string"
          },
          "version": {
            "description": "Version directory name, when the layout has one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "marketplace",
          "plugin"
        ],
        "type": "object",
        "x-untrusted": true
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootKind": {
        "description": "What kind of root a path is.",
        "oneOf": [
          {
            "description": "A harness's own skills directory (`~/.claude/skills`).",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "harness",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          },
          {
            "description": "The shared `.agents/skills` root.",
            "properties": {
              "kind": {
                "const": "universal",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The `.agents/skills-parked` holding root (global only).",
            "properties": {
              "kind": {
                "const": "parked",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A legacy directory a harness still reads (`OpenCode` `skill/`).",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "legacy",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          },
          {
            "description": "A plugin cache the harness ships skills in.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "plugin_cache",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          }
        ]
      },
      "RootRef": {
        "description": "A root, before it is resolved on disk.\n\nInvariant: `(scope, kind)` is unique inside one normalized scope, and\n`Parked` exists only at `Global`. `RootRef::new` enforces the second\nrule; `scan` rejects a deserialized value that breaks it with\n[`ErrorCode::InvalidRequest`] through [`RootRef::validate`].",
        "properties": {
          "kind": {
            "$ref": "#/$defs/RootKind",
            "description": "Harness, universal, parked, legacy, or plugin cache."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Global or project."
          }
        },
        "required": [
          "scope",
          "kind"
        ],
        "type": "object"
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "Severity": {
        "description": "How serious an issue is.\n\nInvariant: `Error` blocks a mutation on the deployment; `Warning` does\nnot; `Off` is informational (the deployment is intentionally disabled).",
        "oneOf": [
          {
            "const": "off",
            "description": "Informational.",
            "type": "string"
          },
          {
            "const": "warning",
            "description": "Should be fixed.",
            "type": "string"
          },
          {
            "const": "error",
            "description": "Must be fixed before the deployment can be changed.",
            "type": "string"
          }
        ]
      },
      "SkillDestination": {
        "description": "Universal (`.agents/skills`) or per-harness destination.",
        "oneOf": [
          {
            "const": "universal",
            "description": "The shared root.",
            "type": "string"
          },
          {
            "const": "per_harness",
            "description": "A harness's own root.",
            "type": "string"
          }
        ]
      },
      "SkillFrontmatter": {
        "description": "`SKILL.md` frontmatter, per the agentskills.io spec. Unknown keys are\nignored by default serde behavior, so agent-specific extensions in a\nskill's frontmatter don't break parsing.",
        "properties": {
          "allowed-tools": {
            "description": "Comma-separated tool allowlist.",
            "type": [
              "string",
              "null"
            ]
          },
          "compatibility": {
            "description": "Optional, spec caps this at 500 chars.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "description": "Required by spec: 1-1024 chars.",
            "type": [
              "string",
              "null"
            ]
          },
          "disable-model-invocation": {
            "description": "Claude Code / pi extension: restricts this skill to explicit\ninvocation only (`/name`, `/skill:name`), hiding it from the model's\nown auto-invoke matching. See [`InvocationPolicy`].",
            "type": [
              "boolean",
              "null"
            ]
          },
          "license": {
            "description": "License identifier or text.",
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "description": "Tolerate non-string metadata values (numbers, lists, nested maps).",
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "description": "Required by spec: 1-64 chars, lowercase a-z0-9 and hyphens, must\nmatch the parent directory name.",
            "type": [
              "string",
              "null"
            ]
          },
          "user-invocable": {
            "description": "Claude Code / pi extension: `false` restricts this skill to model\nauto-invoke only, hiding it from explicit `/name` invocation. See\n[`InvocationPolicy`].",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object",
        "x-untrusted": true
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "SourceKind": {
        "description": "How a skill made it onto disk.\n\nPorted from the desktop's `provenance::SourceKind`. Serializes to the same\nkebab-case strings the frontend has always used. Declaration order doubles\nas precedence order (dotagents beats plugin beats skills-sh beats in-repo\nbeats manual) via the derived `Ord`, matching the desktop's\n`classify_source_kind`.",
        "oneOf": [
          {
            "const": "dotagents",
            "description": "Symlinked in by getsentry/dotagents.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "Shipped by an agent plugin.",
            "type": "string"
          },
          {
            "const": "skills-sh",
            "description": "Present in the skills.sh lock file.",
            "type": "string"
          },
          {
            "const": "in-repo",
            "description": "A plain directory with no skill-manager provenance, but sitting\ninside a git working tree.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "A plain directory with no other provenance signal.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "Detached from its dotagents/skills.sh ledger via \"Fork\" so local\nedits survive `sync`/`update`. Never produced by classification\ndirectly; assigned afterward from the fork registry.",
            "type": "string"
          }
        ]
      },
      "Timing": {
        "description": "How long one phase took.",
        "properties": {
          "elapsed_ms": {
            "description": "Elapsed milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "phase": {
            "description": "Phase name.",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "elapsed_ms"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `diagnose`.",
    "properties": {
      "inventory": {
        "$ref": "#/$defs/Inventory",
        "description": "The inventory the issues were derived from."
      },
      "issues": {
        "description": "Issues sorted by severity, then skill, then kind.",
        "items": {
          "$ref": "#/$defs/Issue"
        },
        "type": "array"
      }
    },
    "required": [
      "inventory",
      "issues"
    ],
    "title": "Diagnosis",
    "type": "object"
  },
  "crates/skill-studio-core/schema/doctor_report.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DoctorInvariant": {
        "description": "One of the six doctor invariants from `docs/flows.md`. Carries\n`Serialize`/`Deserialize`/`JsonSchema` (unlike the rest of this\ndetect-only module) because `ops::doctor`'s [`crate::dto::DoctorReport`]\ncrosses the CLI/desktop/MCP boundary and needs to name which invariant a\nviolation is.",
        "oneOf": [
          {
            "const": "link_resolves_in_root",
            "description": "1. Every link resolves inside its root.",
            "type": "string"
          },
          {
            "const": "registry_entry_has_folder",
            "description": "2. Every registry entry has a folder.",
            "type": "string"
          },
          {
            "const": "lockfile_entry_has_folder",
            "description": "3. Every lockfile entry has a folder.",
            "type": "string"
          },
          {
            "const": "no_folder_in_two_states",
            "description": "4. No folder is in two states at once.",
            "type": "string"
          },
          {
            "const": "quarantine_within_cap",
            "description": "5. Quarantine stays within its retention cap.",
            "type": "string"
          },
          {
            "const": "journal_has_no_open_plan",
            "description": "6. The journal has no open plan at rest.",
            "type": "string"
          }
        ]
      },
      "DoctorViolation": {
        "description": "One violation of a [`crate::doctor::DoctorInvariant`] found by `doctor`,\nprojected from `crate::doctor::DoctorViolation` into a serializable\nshape: `skill` folds into `detail`'s message text rather than a\nseparate field, since every existing violation message already names\nthe skill when it has one (see each `doctor::check_*` function).",
        "properties": {
          "detail": {
            "description": "Message for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "invariant": {
            "$ref": "#/$defs/DoctorInvariant",
            "description": "Which invariant is violated."
          },
          "path": {
            "description": "Path of the offending entry, when the invariant names one.",
            "type": "string",
            "x-untrusted": true
          },
          "severity": {
            "$ref": "#/$defs/Severity",
            "default": "error",
            "description": "Warning for a retained entry or external link; error for broken state."
          }
        },
        "required": [
          "invariant",
          "path",
          "detail"
        ],
        "type": "object"
      },
      "ListingCost": {
        "description": "Listing cost for one harness in one session scope.",
        "properties": {
          "context_window_tokens": {
            "description": "Context size used for a fractional budget.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "estimated_tokens_chars_div_4": {
            "description": "UTF-16 characters (UTF-8 bytes for Codex), divided by four and rounded up.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Harness id."
          },
          "limit_source": {
            "description": "Setting file path, default, or reason the limit is unknown.",
            "type": "string"
          },
          "limit_tokens": {
            "description": "Budget in estimated tokens, or null when not verified.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "listed_skills": {
            "description": "Number of model-visible skill entries.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Project sessions include global skills. Identity rules depend on the harness."
          },
          "top_skills": {
            "description": "The five largest entries, with names as a stable tie break.",
            "items": {
              "$ref": "#/$defs/ListingSkillCost"
            },
            "type": "array"
          },
          "uses_default_context_window": {
            "description": "Whether a verified fallback was used instead of a session context size.",
            "type": "boolean"
          },
          "warning": {
            "description": "`over_limit` or `near_limit` at 80 percent, otherwise null.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "harness",
          "scope",
          "listed_skills",
          "estimated_tokens_chars_div_4",
          "limit_source",
          "uses_default_context_window",
          "top_skills"
        ],
        "type": "object"
      },
      "ListingSkillCost": {
        "description": "One skill's contribution to the listing.",
        "properties": {
          "estimated_tokens_chars_div_4": {
            "description": "UTF-16 characters (UTF-8 bytes for Codex), divided by four and rounded up.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "Model-visible name.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "estimated_tokens_chars_div_4"
        ],
        "type": "object"
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "Severity": {
        "description": "How serious an issue is.\n\nInvariant: `Error` blocks a mutation on the deployment; `Warning` does\nnot; `Off` is informational (the deployment is intentionally disabled).",
        "oneOf": [
          {
            "const": "off",
            "description": "Informational.",
            "type": "string"
          },
          {
            "const": "warning",
            "description": "Should be fixed.",
            "type": "string"
          },
          {
            "const": "error",
            "description": "Must be fixed before the deployment can be changed.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `doctor`: one pass over every lifecycle invariant in\n`docs/flows.md`, over the\nwhole scope (every root `scan` knows, every registry and lockfile\nentry, the quarantine dirs, the journal), independent of any single\ncommand's own rollback logic.",
    "properties": {
      "checked": {
        "description": "Skills the pass examined for invariants 1-4 (link, registry,\nlockfile, two-states); invariants 5 (quarantine) and 6 (journal)\ncheck one directory and one journal each regardless of skill count,\nso this does not add them in.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "listing_cost": {
        "default": [],
        "description": "Estimated skill listing cost per harness and session scope.",
        "items": {
          "$ref": "#/$defs/ListingCost"
        },
        "type": "array"
      },
      "violations": {
        "description": "Every violation found; empty means a healthy scope.",
        "items": {
          "$ref": "#/$defs/DoctorViolation"
        },
        "type": "array"
      }
    },
    "required": [
      "violations",
      "checked"
    ],
    "title": "DoctorReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/doctor_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `doctor`. Empty: a doctor pass always runs over the whole\nscope the running `Runtime` already knows, not one skill at a time.",
    "title": "DoctorRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/event_dto.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DriftState": {
        "description": "Whether the files an event touched still hold the bytes it recorded.",
        "oneOf": [
          {
            "const": "unchecked",
            "description": "`list_events` did not compare fingerprints (the row has no inverse,\nor the caller did not ask).",
            "type": "string"
          },
          {
            "const": "clean",
            "description": "Live fingerprints match the recorded post-mutation fingerprints.",
            "type": "string"
          },
          {
            "const": "drifted",
            "description": "At least one path changed since the event; restore needs `force`.",
            "type": "string"
          }
        ]
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "RestoreCapability": {
        "description": "Whether a history event can be restored.",
        "oneOf": [
          {
            "description": "Restore is available.",
            "properties": {
              "restorable": {
                "const": "yes",
                "type": "string"
              }
            },
            "required": [
              "restorable"
            ],
            "type": "object"
          },
          {
            "description": "Already reverted by the named event.",
            "properties": {
              "by": {
                "$ref": "#/$defs/EventId",
                "description": "The restore event."
              },
              "restorable": {
                "const": "reverted",
                "type": "string"
              }
            },
            "required": [
              "restorable",
              "by"
            ],
            "type": "object"
          },
          {
            "description": "Retention has expired the event's backup.",
            "properties": {
              "restorable": {
                "const": "backup_expired",
                "type": "string"
              },
              "reverted_by": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EventId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A previous restore, if the event had already been undone."
              }
            },
            "required": [
              "restorable"
            ],
            "type": "object"
          },
          {
            "description": "The row has no inverse.",
            "properties": {
              "restorable": {
                "const": "no_inverse",
                "type": "string"
              }
            },
            "required": [
              "restorable"
            ],
            "type": "object"
          },
          {
            "description": "The row's kind is not known to this version of the core.",
            "properties": {
              "restorable": {
                "const": "unknown_kind",
                "type": "string"
              }
            },
            "required": [
              "restorable"
            ],
            "type": "object"
          },
          {
            "description": "`pending`, or `failed`/`interrupted` without a `restore_backup`\ninverse and a `backup_dir`: the row's inverse never moved what it\ndescribes, or there is no backup for a drift-checked restore to\napply, so applying it would act on live state the row does not own.",
            "properties": {
              "restorable": {
                "const": "not_completed",
                "type": "string"
              },
              "status": {
                "description": "The row's status, so a caller can explain the refusal.",
                "type": "string"
              }
            },
            "required": [
              "restorable",
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "History row projected for display.",
    "properties": {
      "backup_dir": {
        "description": "Relative backup directory, when bytes were preserved.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "drift": {
        "$ref": "#/$defs/DriftState",
        "description": "Whether the touched files still match the recorded fingerprints."
      },
      "harness": {
        "anyOf": [
          {
            "$ref": "#/$defs/AgentIdentity"
          },
          {
            "type": "null"
          }
        ],
        "description": "Harness, when harness-scoped."
      },
      "id": {
        "$ref": "#/$defs/EventId",
        "description": "Id."
      },
      "kind": {
        "description": "Kind, verbatim from the row.",
        "type": "string"
      },
      "project_path": {
        "description": "Project path, when project-scoped.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "restore": {
        "$ref": "#/$defs/RestoreCapability",
        "description": "Whether restore is possible."
      },
      "scope": {
        "description": "`global` or `project`.",
        "type": [
          "string",
          "null"
        ]
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "Skill."
      },
      "status": {
        "description": "`pending`, `done`, `failed`, or `interrupted`.",
        "type": "string"
      },
      "ts": {
        "description": "Time.",
        "format": "date-time",
        "type": "string"
      }
    },
    "required": [
      "id",
      "ts",
      "kind",
      "skill",
      "status",
      "restore",
      "drift"
    ],
    "title": "EventDto",
    "type": "object"
  },
  "crates/skill-studio-core/schema/extras_report.schema.json": {
    "$defs": {
      "ExtraEntry": {
        "description": "One declaration, or one file that could not be read.",
        "properties": {
          "count": {
            "description": "Handler count for hooks. One for other declarations, zero for unreadable files.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "harness": {
            "description": "Agent wire name.",
            "type": "string"
          },
          "kind": {
            "description": "`hook`, `mcp_server`, `instruction`, or `config` for an unreadable file.",
            "type": "string"
          },
          "name": {
            "description": "Event, server, or instruction filename. Absent on unreadable files.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "path": {
            "description": "File that declares this item.",
            "type": "string",
            "x-untrusted": true
          },
          "project": {
            "description": "Project root for a project declaration.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "scope": {
            "description": "`global` or `project`.",
            "type": "string"
          },
          "status": {
            "description": "`found` or `unreadable`. Parser errors are never exposed.",
            "type": "string"
          }
        },
        "required": [
          "harness",
          "scope",
          "kind",
          "path",
          "count",
          "status"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Flat list of declarations. Trust and enable settings are not evaluated.",
    "properties": {
      "entries": {
        "description": "Declarations in stable harness, scope, path, kind, and name order.",
        "items": {
          "$ref": "#/$defs/ExtraEntry"
        },
        "type": "array"
      }
    },
    "required": [
      "entries"
    ],
    "title": "ExtrasReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/extras_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Empty input. The runtime scope selects the home and projects.",
    "title": "ExtrasRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/fix_skill_outcome.schema.json": {
    "$defs": {
      "ConflictSummary": {
        "description": "One pair of differing copies: never merged, named for the caller to open\nside by side in the user's editor.",
        "properties": {
          "message": {
            "description": "One-line summary for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "path_a": {
            "description": "First copy's path.",
            "type": "string",
            "x-untrusted": true
          },
          "path_b": {
            "description": "Second copy's path.",
            "type": "string",
            "x-untrusted": true
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "Skill the conflict belongs to."
          }
        },
        "required": [
          "skill",
          "message",
          "path_a",
          "path_b"
        ],
        "type": "object"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "FixApplied": {
        "description": "One repair `fix_skill` applied.",
        "oneOf": [
          {
            "description": "A frontmatter repair was written, the same write\n`apply_frontmatter_repair` performs.",
            "properties": {
              "deployment_id": {
                "$ref": "#/$defs/DeploymentId",
                "description": "Deployment written."
              },
              "event_id": {
                "$ref": "#/$defs/EventId",
                "description": "History event."
              },
              "kind": {
                "const": "frontmatter_repair",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "deployment_id",
              "event_id"
            ],
            "type": "object"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "UnrepairedIssue": {
        "description": "One issue `fix_skill` found but could not repair, named with its path so\nthe caller can show it rather than a generic toast.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/UnrepairedIssueKind",
            "description": "Stable category a caller can branch on instead of `message`."
          },
          "message": {
            "description": "Message for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "path": {
            "description": "Path of the offending file or folder, when the issue names one.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "path",
          "message",
          "kind"
        ],
        "type": "object"
      },
      "UnrepairedIssueKind": {
        "description": "Stable category for [`UnrepairedIssue`] so a caller can branch on\nstructure instead of matching a substring of `message`.",
        "oneOf": [
          {
            "const": "link",
            "description": "A dangling or unreadable symlink the detail page's own repair card\nknows how to fix.",
            "type": "string"
          },
          {
            "const": "frontmatter",
            "description": "A frontmatter field or value `fix_skill` could not repair.",
            "type": "string"
          },
          {
            "const": "other",
            "description": "Anything else (registry/lockfile drift, quarantine cap, and so on).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `fix_skill`.",
    "properties": {
      "applied": {
        "description": "Repairs written.",
        "items": {
          "$ref": "#/$defs/FixApplied"
        },
        "type": "array"
      },
      "conflicts": {
        "description": "Conflicts found; the app opens both paths in the user's editor.",
        "items": {
          "$ref": "#/$defs/ConflictSummary"
        },
        "type": "array"
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "Skill the fix ran for."
      },
      "unrepaired": {
        "description": "Issues named but not repaired, with their paths.",
        "items": {
          "$ref": "#/$defs/UnrepairedIssue"
        },
        "type": "array"
      }
    },
    "required": [
      "skill",
      "applied",
      "unrepaired",
      "conflicts"
    ],
    "title": "FixSkillOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/fix_skill_request.schema.json": {
    "$defs": {
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `fix_skill`.",
    "properties": {
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "Skill to run the doctor checks and repairs for."
      }
    },
    "required": [
      "skill"
    ],
    "title": "FixSkillRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/frontmatter_repair_preview.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "Fingerprint": {
        "description": "Content fingerprint in the `sha256:<hex>` form.\n\nInvariant: the hex is lowercase and 64 characters long. One scheme covers\nfiles, trees, and proposals; the old untyped hex form is parsed on read.",
        "type": "string"
      },
      "LifecycleOwnerKind": {
        "description": "Which ledger owns a deployment's lifecycle.",
        "oneOf": [
          {
            "const": "skills_sh",
            "description": "`~/.agents/.skill-lock.json`.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "A dotagents ledger.",
            "type": "string"
          },
          {
            "const": "copy",
            "description": "A copy install recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "A fork recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A harness plugin cache.",
            "type": "string"
          },
          {
            "const": "in_repo",
            "description": "Committed in the project repository.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "Placed by hand.",
            "type": "string"
          },
          {
            "const": "wildcard_dotagents",
            "description": "A dotagents wildcard entry.",
            "type": "string"
          },
          {
            "const": "ambiguous",
            "description": "More than one ledger claims the name.",
            "type": "string"
          }
        ]
      },
      "OwnerId": {
        "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
        "type": "string"
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "ProposalId": {
        "description": "Id of a frontmatter repair proposal.\n\nInvariant: sha256 over deployment id, path, owner id, owner kind, the\nexpected fingerprint, and the proposed text. Any change makes a new id.",
        "type": "string"
      },
      "RepairApplyMode": {
        "description": "Ways a frontmatter repair may be applied.",
        "oneOf": [
          {
            "const": "apply-fix",
            "description": "Rewrite the file in place.",
            "type": "string"
          },
          {
            "const": "fix-installed-copy",
            "description": "Rewrite the installed copy that a ledger owns.",
            "type": "string"
          },
          {
            "const": "fork-and-fix",
            "description": "Fork first, then rewrite the fork.",
            "type": "string"
          }
        ]
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A proposed frontmatter repair.\n\nInvariant: `apply_frontmatter_repair` refuses the proposal when the file\nno longer matches `expected_fingerprint` or the owner changed. The repair\nis deterministic: apply recomputes the proposal from the bytes on disk\nand compares `proposal_id`, so the caller's `proposed_content` is shown,\nnever written.",
    "properties": {
      "allowed_apply_modes": {
        "description": "Modes the caller may choose from.",
        "items": {
          "$ref": "#/$defs/RepairApplyMode"
        },
        "type": "array"
      },
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "Target deployment."
      },
      "diff": {
        "description": "Unified diff for a person.",
        "type": "string",
        "x-untrusted": true
      },
      "expected_fingerprint": {
        "$ref": "#/$defs/Fingerprint",
        "description": "Fingerprint of the current `SKILL.md` bytes."
      },
      "managed_update_warning": {
        "description": "Warning shown for [`RepairApplyMode::FixInstalledCopy`]: the next\nmanaged update overwrites the fix.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "original_content": {
        "description": "Current `SKILL.md` text, for a side-by-side view.",
        "type": "string",
        "x-untrusted": true
      },
      "owner_id": {
        "anyOf": [
          {
            "$ref": "#/$defs/OwnerId"
          },
          {
            "type": "null"
          }
        ],
        "description": "Owner at preview time."
      },
      "owner_kind": {
        "$ref": "#/$defs/LifecycleOwnerKind",
        "description": "Owner kind at preview time."
      },
      "path": {
        "description": "Absolute path of `SKILL.md`.",
        "type": "string",
        "x-untrusted": true
      },
      "proposal_id": {
        "$ref": "#/$defs/ProposalId",
        "description": "Proposal id."
      },
      "proposed_content": {
        "description": "Proposed `SKILL.md` text, for a side-by-side view.",
        "type": "string",
        "x-untrusted": true
      },
      "proposed_fingerprint": {
        "$ref": "#/$defs/Fingerprint",
        "description": "Fingerprint of the proposed bytes."
      },
      "reason": {
        "description": "Why the repair is proposed, for a person (the spec rule that fails).",
        "type": "string",
        "x-untrusted": true
      },
      "scope": {
        "$ref": "#/$defs/RootScope",
        "description": "Scope of the deployment's root."
      }
    },
    "required": [
      "proposal_id",
      "deployment_id",
      "path",
      "scope",
      "reason",
      "owner_kind",
      "expected_fingerprint",
      "proposed_fingerprint",
      "original_content",
      "proposed_content",
      "diff",
      "allowed_apply_modes"
    ],
    "title": "FrontmatterRepairPreview",
    "type": "object"
  },
  "crates/skill-studio-core/schema/install_outcome.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "InstallHarnessResult": {
        "description": "What `install` did for one requested harness.",
        "oneOf": [
          {
            "description": "The harness reads the skill from the shared folder at `path`, either\ndirectly or because its own folder is a link to the shared folder.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity",
                "description": "The requested harness (or `universal`)."
              },
              "kind": {
                "const": "reads_shared",
                "type": "string"
              },
              "path": {
                "description": "The skill folder the harness reads.",
                "type": "string",
                "x-untrusted": true
              }
            },
            "required": [
              "kind",
              "harness",
              "path"
            ],
            "type": "object"
          },
          {
            "description": "A relative symlink at `path` points to the shared folder's copy.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity",
                "description": "The requested harness."
              },
              "kind": {
                "const": "linked",
                "type": "string"
              },
              "path": {
                "description": "The new link.",
                "type": "string",
                "x-untrusted": true
              }
            },
            "required": [
              "kind",
              "harness",
              "path"
            ],
            "type": "object"
          },
          {
            "description": "A real folder at `path`.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity",
                "description": "The requested harness."
              },
              "kind": {
                "const": "copied",
                "type": "string"
              },
              "link_failed": {
                "description": "`true` when a link was asked for but the symlink failed, so the\nfolder was copied instead.",
                "type": "boolean"
              },
              "path": {
                "description": "The new folder.",
                "type": "string",
                "x-untrusted": true
              }
            },
            "required": [
              "kind",
              "harness",
              "path",
              "link_failed"
            ],
            "type": "object"
          },
          {
            "description": "Nothing was written for this harness.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity",
                "description": "The requested harness."
              },
              "kind": {
                "const": "skipped",
                "type": "string"
              },
              "reason": {
                "description": "Why, in one plain sentence.",
                "type": "string",
                "x-untrusted": true
              }
            },
            "required": [
              "kind",
              "harness",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `install`.",
    "oneOf": [
      {
        "description": "The skill was installed.",
        "properties": {
          "deployment_path": {
            "description": "Where its canonical folder now lives.",
            "type": "string",
            "x-untrusted": true
          },
          "event_id": {
            "$ref": "#/$defs/EventId",
            "description": "The `install` event."
          },
          "harness_results": {
            "default": [],
            "description": "What happened for each requested harness, in request order.",
            "items": {
              "$ref": "#/$defs/InstallHarnessResult"
            },
            "type": "array"
          },
          "kind": {
            "const": "installed",
            "type": "string"
          },
          "linked_harnesses": {
            "description": "Harnesses that now see the skill through a per-skill link or a\nwhole-folder link into the shared folder.",
            "items": {
              "$ref": "#/$defs/AgentIdentity"
            },
            "type": "array"
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "The skill that was installed."
          }
        },
        "required": [
          "kind",
          "event_id",
          "skill",
          "deployment_path",
          "linked_harnesses"
        ],
        "type": "object"
      },
      {
        "description": "`trust_identity` was set, is not yet trusted, and `trust_confirmed`\nwas `false`. Nothing was written; retry with `trust_confirmed: true`\nonce the user confirms.",
        "properties": {
          "identity": {
            "description": "The normalized identity that needs confirming.",
            "type": "string",
            "x-untrusted": true
          },
          "kind": {
            "const": "needs_trust",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "identity"
        ],
        "type": "object"
      }
    ],
    "title": "InstallOutcome"
  },
  "crates/skill-studio-core/schema/install_preferences.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "InstallMethod": {
        "description": "Which of the three ways `ops::install` can put a skill's bytes on disk.",
        "oneOf": [
          {
            "const": "copy",
            "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "`npx -y @sentry/dotagents add <source>`.",
            "type": "string"
          },
          {
            "const": "skills_sh",
            "description": "`npx -y skills add <source>`.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The method and harnesses the last successful install saved, or the\nenvironment default when nothing has been saved yet.",
    "properties": {
      "harnesses": {
        "description": "The saved or defaulted harnesses.",
        "items": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "type": "array"
      },
      "method": {
        "$ref": "#/$defs/InstallMethod",
        "description": "The saved or defaulted method."
      },
      "saved": {
        "description": "`false` when `method`/`harnesses` are an environment default rather\nthan a saved preference (no install has completed on this scope\nyet).",
        "type": "boolean"
      }
    },
    "required": [
      "method",
      "harnesses",
      "saved"
    ],
    "title": "InstallPreferences",
    "type": "object"
  },
  "crates/skill-studio-core/schema/install_preferences_request.schema.json": {
    "$defs": {
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `install_preferences`: which scope's saved preference to\nread. Defaults to the global root, so a caller that only ever installs\nglobally sends nothing.",
    "properties": {
      "scope": {
        "$ref": "#/$defs/RootScope",
        "default": {
          "scope": "global"
        },
        "description": "`Global` reads the scope home's preference; `Project` reads one\nproject's."
      }
    },
    "title": "InstallPreferencesRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/install_request.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "InstallFile": {
        "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
        "properties": {
          "contents": {
            "description": "The file's bytes.",
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "mode": {
            "default": null,
            "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "relative_path": {
            "description": "Path relative to the skill folder's own root.",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "contents"
        ],
        "type": "object"
      },
      "InstallLinkMode": {
        "description": "How `install` puts the skill into each chosen harness that has its own\nfolder - the `skills` CLI's symlink/`--copy` choice. `install` forces\n`Copy` when the chosen harnesses resolve to one folder or fewer, the same\nas the CLI, and always uses `Link` for `Dotagents`.",
        "oneOf": [
          {
            "const": "link",
            "description": "One real folder at `<scope>/.agents/skills/<name>`, and a relative\nsymlink to it in each other chosen harness folder.",
            "type": "string"
          },
          {
            "const": "copy",
            "description": "One real folder in each chosen harness folder. The shared folder\ngets one only when a harness that reads it is chosen.",
            "type": "string"
          }
        ]
      },
      "InstallMethod": {
        "description": "Which of the three ways `ops::install` can put a skill's bytes on disk.",
        "oneOf": [
          {
            "const": "copy",
            "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "`npx -y @sentry/dotagents add <source>`.",
            "type": "string"
          },
          {
            "const": "skills_sh",
            "description": "`npx -y skills add <source>`.",
            "type": "string"
          }
        ]
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "SkillDestination": {
        "description": "Universal (`.agents/skills`) or per-harness destination.",
        "oneOf": [
          {
            "const": "universal",
            "description": "The shared root.",
            "type": "string"
          },
          {
            "const": "per_harness",
            "description": "A harness's own root.",
            "type": "string"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to install one skill by [`InstallMethod::Copy`], `Dotagents`, or\n`SkillsSh`.",
    "properties": {
      "destination": {
        "$ref": "#/$defs/SkillDestination",
        "default": "universal",
        "description": "`Universal` is the `skills` CLI's pick above. `PerHarness` (`Copy`\nonly) gives every chosen harness a real folder in its own skills\nfolder, Codex, `OpenCode`, and Cursor included, and writes no shared\ncopy; `link_mode` is ignored."
      },
      "files": {
        "default": [],
        "description": "`Copy` only: the folder's files, staged then swapped into place.",
        "items": {
          "$ref": "#/$defs/InstallFile"
        },
        "type": "array"
      },
      "harnesses": {
        "default": [],
        "description": "The harness set to install for, as the `skills` CLI's `--agent` list:\nharness ids plus the pseudo id `universal` for the shared\n`.agents/skills` folder alone. Empty means `universal` only. Codex,\n`OpenCode`, Cursor, and `universal` read the shared folder; Claude\nCode, pi, and Grok Build get their own folder (see `link_mode`).",
        "items": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "type": "array"
      },
      "link_mode": {
        "$ref": "#/$defs/InstallLinkMode",
        "default": "link",
        "description": "How each chosen harness with its own folder receives the skill. See\n[`InstallLinkMode`]."
      },
      "method": {
        "$ref": "#/$defs/InstallMethod",
        "description": "Which method writes the bytes."
      },
      "save_as_preference": {
        "default": true,
        "description": "Saves this call's method and harnesses as the preference\n`install_preferences` returns for the next install. Defaults to\n`true` so a caller opts out, not in.",
        "type": "boolean"
      },
      "scope": {
        "$ref": "#/$defs/RootScope",
        "description": "`Global` installs under the scope home; `Project` installs under one\nproject."
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The folder name the skill will be installed under, both at\n`.agents/skills/<name>` and, for `Dotagents`/`SkillsSh`, the name the\nCLI is expected to create."
      },
      "source": {
        "default": null,
        "description": "`Dotagents`/`SkillsSh` only: the source argument passed to the CLI's\n`add` command (for example `owner/repo`).",
        "type": [
          "string",
          "null"
        ]
      },
      "trust_confirmed": {
        "default": false,
        "description": "Confirms the trust prompt for `trust_identity`. A first call with\nthis `false` against an untrusted identity returns\n[`InstallOutcome::NeedsTrust`] instead of writing.",
        "type": "boolean"
      },
      "trust_identity": {
        "default": null,
        "description": "The source's normalized repository identity, for the trust check\n(`None` for a source the policy never gates, like a local path).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "skill",
      "method",
      "scope"
    ],
    "title": "InstallRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/inventory.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "BackingRelationship": {
        "description": "How a deployment is wired to its bytes.",
        "oneOf": [
          {
            "const": "canonical",
            "description": "The directory holds the bytes.",
            "type": "string"
          },
          {
            "const": "linked_to",
            "description": "A symlink to another deployment.",
            "type": "string"
          },
          {
            "const": "independent",
            "description": "A copy that no longer tracks its source.",
            "type": "string"
          }
        ]
      },
      "Completeness": {
        "description": "Whether a scan saw everything it was asked to see.",
        "oneOf": [
          {
            "const": "complete",
            "description": "Every root was read.",
            "type": "string"
          },
          {
            "const": "partial",
            "description": "Some roots were skipped; see `observations`.",
            "type": "string"
          }
        ]
      },
      "CopyStatus": {
        "description": "How an agent copy compares with the library copy in its scope.",
        "oneOf": [
          {
            "const": "link",
            "description": "A link that resolves to the library copy.",
            "type": "string"
          },
          {
            "const": "same",
            "description": "A real folder with the same files as the library copy.",
            "type": "string"
          },
          {
            "const": "differs",
            "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
            "type": "string"
          },
          {
            "const": "stale",
            "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
            "type": "string"
          }
        ]
      },
      "DeploymentDto": {
        "description": "One installed copy or link of a skill.\n\nInvariant: `harness` is an [`AgentId`] or `None` for the universal and\nparked roots; it is never a display string. `plugin` is `Some` exactly\nwhen `root.kind` is [`crate::identity::RootKind::PluginCache`].",
        "properties": {
          "backing": {
            "$ref": "#/$defs/BackingRelationship",
            "description": "How the bytes are backed."
          },
          "content_fingerprint": {
            "anyOf": [
              {
                "$ref": "#/$defs/Fingerprint"
              },
              {
                "type": "null"
              }
            ],
            "description": "Content fingerprint over the directory tree."
          },
          "content_hash": {
            "description": "sha256 over the sorted (relative path, bytes) pairs of the skill\nfolder. Distinct from `content_fingerprint`: a different, whole-folder\nscheme kept for parity with the desktop's `SkillCandidate`.",
            "type": "string"
          },
          "copy_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/CopyStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "For an agent copy, how it compares with the library copy\n(`.agents/skills`) in the same scope. `None` for the library copy,\na plugin or parked copy, a broken link, or an agent copy with no\nlibrary copy."
          },
          "description_tokens": {
            "description": "Token count of just `\"{name}: {description}\"` - the prompt cost the\nmodel actually pays per turn, as opposed to `skill_md_tokens` which\ncounts the whole file.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "destination": {
            "$ref": "#/$defs/SkillDestination",
            "description": "Universal or per-harness."
          },
          "disabled_by": {
            "anyOf": [
              {
                "$ref": "#/$defs/DisabledBy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the deployment is off, when it is."
          },
          "disabled_readers": {
            "description": "Readers of a universal deployment that have it disabled.",
            "items": {
              "$ref": "#/$defs/AgentIdentity"
            },
            "type": "array"
          },
          "file_count": {
            "description": "Total files counted while walking the skill folder.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "folder_bytes": {
            "description": "Total bytes read while walking the skill folder.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "folder_truncated": {
            "description": "True when the folder walk hit the file-count or byte cap and stopped\nearly - `folder_bytes`/`file_count`/`content_hash` are partial.",
            "type": "boolean"
          },
          "frontmatter": {
            "anyOf": [
              {
                "$ref": "#/$defs/SkillFrontmatter"
              },
              {
                "type": "null"
              }
            ],
            "description": "Parsed `SKILL.md` frontmatter, when the file parsed."
          },
          "frontmatter_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Every top-level frontmatter key, stringified.",
            "type": "object",
            "x-untrusted": true
          },
          "harness": {
            "anyOf": [
              {
                "$ref": "#/$defs/AgentIdentity"
              },
              {
                "type": "null"
              }
            ],
            "description": "Harness that owns the root, when it is a harness root."
          },
          "has_spec": {
            "description": "True when the SKILL.md matches the getsentry/skillet spec pattern.",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Opaque id."
          },
          "in_git_repo": {
            "description": "True when the skill's directory sits inside a git working tree (a\n`.git` file or directory on some ancestor). Distinguishes a\nversion-controlled directory from a genuinely unmanaged one - see\n[`SourceKind::InRepo`].",
            "type": "boolean"
          },
          "is_symlink": {
            "description": "True when the deployment's own directory entry is a symlink.",
            "type": "boolean"
          },
          "link_target": {
            "description": "Link target, when the deployment is a symlink.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "modified_at": {
            "description": "RFC3339 of the newest file mtime in the skill folder.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "mutability": {
            "$ref": "#/$defs/DeploymentMutability",
            "description": "Whether writes are allowed."
          },
          "owner_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/OwnerId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Owner id, when a ledger owns it."
          },
          "owner_kind": {
            "$ref": "#/$defs/LifecycleOwnerKind",
            "description": "Which ledger owns the lifecycle."
          },
          "parked_origin": {
            "anyOf": [
              {
                "$ref": "#/$defs/RootRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a parked copy, the root it came from and returns to: the scope\n(with the project path) and `Universal` or the agent's own root.\n`None` for a copy that is not parked."
          },
          "parked_owner_kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/LifecycleOwnerKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a parked copy, the owner type it had before Park, read from the\nslot's origin marker. Provenance only: `owner_kind` still says what\nmanages the parked copy now. `None` for a copy that is not parked or\nwas parked before the marker recorded it."
          },
          "path": {
            "description": "Absolute lexical path of the skill directory.",
            "type": "string",
            "x-untrusted": true
          },
          "plugin": {
            "anyOf": [
              {
                "$ref": "#/$defs/PluginSourceDto"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plugin provenance for a plugin-cache deployment."
          },
          "resolved_path": {
            "description": "Canonicalized directory the deployment resolves to, when that is\nmeaningfully different from `path`. Distinct from `link_target`:\n`link_target` is the symlink's own target, while `resolved_path` is\n`None` for an ordinary directory that canonicalizes to itself or for\na symlink whose target does not resolve.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "root": {
            "$ref": "#/$defs/RootRef",
            "description": "Root the deployment lives in."
          },
          "shared_via_whole_dir_link": {
            "description": "True when the skills root itself is a link into the universal root.",
            "type": "boolean"
          },
          "skill_md_tokens": {
            "description": "Token count of the whole `SKILL.md` file.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "source_kind": {
            "$ref": "#/$defs/SourceKind",
            "description": "Provenance classification, per `apps/desktop`'s\n`provenance::classify_source_kind`."
          },
          "spec_violations": {
            "description": "Spec violations, verbatim messages.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "studio_disabled": {
            "description": "True when this deployment was found inside a root's\n`.skill-studio-disabled/` holding directory. Maps to `disabled_by ==\nSome(DisabledBy::StudioMoved)`.",
            "type": "boolean"
          },
          "symlink_error": {
            "description": "Error reading the symlink target, when one occurred.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "symlink_is_broken": {
            "description": "True when the deployment is a symlink whose target does not resolve.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "root",
          "path",
          "destination",
          "backing",
          "mutability",
          "shared_via_whole_dir_link",
          "is_symlink",
          "symlink_is_broken",
          "owner_kind",
          "disabled_readers",
          "spec_violations",
          "frontmatter_fields",
          "has_spec",
          "folder_bytes",
          "file_count",
          "skill_md_tokens",
          "description_tokens",
          "content_hash",
          "folder_truncated",
          "in_git_repo",
          "studio_disabled",
          "source_kind"
        ],
        "type": "object"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "DeploymentMutability": {
        "description": "Whether Skill Studio may change a deployment in place.",
        "oneOf": [
          {
            "const": "mutable",
            "description": "Writes are allowed.",
            "type": "string"
          },
          {
            "const": "read_only",
            "description": "Plugin caches and managed ledgers: writes are refused.",
            "type": "string"
          }
        ]
      },
      "DisabledBy": {
        "description": "Why a deployment is off, as shown to the user.\n\nInvariant: the first four names match the desktop wire today; the last\ntwo are new and only appear once the matching mechanism is supported.",
        "oneOf": [
          {
            "const": "codex-config",
            "description": "Codex `[[skills.config]] enabled = false`.",
            "type": "string"
          },
          {
            "const": "opencode-permission",
            "description": "`OpenCode` `permission.skill` deny.",
            "type": "string"
          },
          {
            "const": "claude-link-removed",
            "description": "The Claude Code per-skill link was removed.",
            "type": "string"
          },
          {
            "const": "studio-moved",
            "description": "Skill Studio moved the folder aside.",
            "type": "string"
          },
          {
            "const": "claude-skill-overrides",
            "description": "Claude Code `skillOverrides` set to `off`.",
            "type": "string"
          },
          {
            "const": "pi-settings",
            "description": "pi per-skill toggle.",
            "type": "string"
          }
        ]
      },
      "Fingerprint": {
        "description": "Content fingerprint in the `sha256:<hex>` form.\n\nInvariant: the hex is lowercase and 64 characters long. One scheme covers\nfiles, trees, and proposals; the old untyped hex form is parsed on read.",
        "type": "string"
      },
      "InstalledSkillDto": {
        "description": "One skill with all of its deployments.",
        "properties": {
          "deployments": {
            "description": "Deployments in scan order.",
            "items": {
              "$ref": "#/$defs/DeploymentDto"
            },
            "type": "array"
          },
          "description": {
            "description": "Description from the first readable deployment.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "name": {
            "$ref": "#/$defs/SkillName",
            "description": "Name."
          },
          "source": {
            "description": "Upstream owner/repo from the owning ledger, plugin@marketplace for a\nplugin skill, or manual.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "source",
          "name",
          "deployments"
        ],
        "type": "object"
      },
      "LifecycleOwnerKind": {
        "description": "Which ledger owns a deployment's lifecycle.",
        "oneOf": [
          {
            "const": "skills_sh",
            "description": "`~/.agents/.skill-lock.json`.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "A dotagents ledger.",
            "type": "string"
          },
          {
            "const": "copy",
            "description": "A copy install recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "A fork recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A harness plugin cache.",
            "type": "string"
          },
          {
            "const": "in_repo",
            "description": "Committed in the project repository.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "Placed by hand.",
            "type": "string"
          },
          {
            "const": "wildcard_dotagents",
            "description": "A dotagents wildcard entry.",
            "type": "string"
          },
          {
            "const": "ambiguous",
            "description": "More than one ledger claims the name.",
            "type": "string"
          }
        ]
      },
      "LockOnlySkill": {
        "description": "A lock entry with no installed folder.",
        "properties": {
          "name": {
            "$ref": "#/$defs/SkillName",
            "description": "Ledger key."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Scope containing the ledger."
          },
          "source": {
            "description": "Recorded upstream, or manual for an adopted local folder.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "source",
          "scope"
        ],
        "type": "object"
      },
      "Observation": {
        "description": "Something worth telling the caller that is not an error.",
        "properties": {
          "message": {
            "description": "Message for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "root": {
            "anyOf": [
              {
                "$ref": "#/$defs/RootRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Root the observation is about, when there is one."
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "OwnerId": {
        "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
        "type": "string"
      },
      "PluginSourceDto": {
        "description": "Where a plugin-cache deployment came from, per the agent-plugins.org\nmanifest convention (`<cache>/<marketplace>/<plugin>/<version>/skills/`).",
        "properties": {
          "enabled": {
            "description": "Claude Code's `enabledPlugins[\"<plugin>@<marketplace>\"]` state:\n`Some(false)` when the harness has the plugin switched off,\n`Some(true)` when switched on, `None` when the harness records\nnothing for it (including every non-Claude-Code harness).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "marketplace": {
            "description": "Marketplace directory name.",
            "type": "string"
          },
          "plugin": {
            "description": "Plugin directory name.",
            "type": "string"
          },
          "version": {
            "description": "Version directory name, when the layout has one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "marketplace",
          "plugin"
        ],
        "type": "object",
        "x-untrusted": true
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootKind": {
        "description": "What kind of root a path is.",
        "oneOf": [
          {
            "description": "A harness's own skills directory (`~/.claude/skills`).",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "harness",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          },
          {
            "description": "The shared `.agents/skills` root.",
            "properties": {
              "kind": {
                "const": "universal",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The `.agents/skills-parked` holding root (global only).",
            "properties": {
              "kind": {
                "const": "parked",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A legacy directory a harness still reads (`OpenCode` `skill/`).",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "legacy",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          },
          {
            "description": "A plugin cache the harness ships skills in.",
            "properties": {
              "harness": {
                "$ref": "#/$defs/AgentIdentity"
              },
              "kind": {
                "const": "plugin_cache",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "harness"
            ],
            "type": "object"
          }
        ]
      },
      "RootRef": {
        "description": "A root, before it is resolved on disk.\n\nInvariant: `(scope, kind)` is unique inside one normalized scope, and\n`Parked` exists only at `Global`. `RootRef::new` enforces the second\nrule; `scan` rejects a deserialized value that breaks it with\n[`ErrorCode::InvalidRequest`] through [`RootRef::validate`].",
        "properties": {
          "kind": {
            "$ref": "#/$defs/RootKind",
            "description": "Harness, universal, parked, legacy, or plugin cache."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Global or project."
          }
        },
        "required": [
          "scope",
          "kind"
        ],
        "type": "object"
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "SkillDestination": {
        "description": "Universal (`.agents/skills`) or per-harness destination.",
        "oneOf": [
          {
            "const": "universal",
            "description": "The shared root.",
            "type": "string"
          },
          {
            "const": "per_harness",
            "description": "A harness's own root.",
            "type": "string"
          }
        ]
      },
      "SkillFrontmatter": {
        "description": "`SKILL.md` frontmatter, per the agentskills.io spec. Unknown keys are\nignored by default serde behavior, so agent-specific extensions in a\nskill's frontmatter don't break parsing.",
        "properties": {
          "allowed-tools": {
            "description": "Comma-separated tool allowlist.",
            "type": [
              "string",
              "null"
            ]
          },
          "compatibility": {
            "description": "Optional, spec caps this at 500 chars.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "description": "Required by spec: 1-1024 chars.",
            "type": [
              "string",
              "null"
            ]
          },
          "disable-model-invocation": {
            "description": "Claude Code / pi extension: restricts this skill to explicit\ninvocation only (`/name`, `/skill:name`), hiding it from the model's\nown auto-invoke matching. See [`InvocationPolicy`].",
            "type": [
              "boolean",
              "null"
            ]
          },
          "license": {
            "description": "License identifier or text.",
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "description": "Tolerate non-string metadata values (numbers, lists, nested maps).",
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "description": "Required by spec: 1-64 chars, lowercase a-z0-9 and hyphens, must\nmatch the parent directory name.",
            "type": [
              "string",
              "null"
            ]
          },
          "user-invocable": {
            "description": "Claude Code / pi extension: `false` restricts this skill to model\nauto-invoke only, hiding it from explicit `/name` invocation. See\n[`InvocationPolicy`].",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object",
        "x-untrusted": true
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "SourceKind": {
        "description": "How a skill made it onto disk.\n\nPorted from the desktop's `provenance::SourceKind`. Serializes to the same\nkebab-case strings the frontend has always used. Declaration order doubles\nas precedence order (dotagents beats plugin beats skills-sh beats in-repo\nbeats manual) via the derived `Ord`, matching the desktop's\n`classify_source_kind`.",
        "oneOf": [
          {
            "const": "dotagents",
            "description": "Symlinked in by getsentry/dotagents.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "Shipped by an agent plugin.",
            "type": "string"
          },
          {
            "const": "skills-sh",
            "description": "Present in the skills.sh lock file.",
            "type": "string"
          },
          {
            "const": "in-repo",
            "description": "A plain directory with no skill-manager provenance, but sitting\ninside a git working tree.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "A plain directory with no other provenance signal.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "Detached from its dotagents/skills.sh ledger via \"Fork\" so local\nedits survive `sync`/`update`. Never produced by classification\ndirectly; assigned afterward from the fork registry.",
            "type": "string"
          }
        ]
      },
      "Timing": {
        "description": "How long one phase took.",
        "properties": {
          "elapsed_ms": {
            "description": "Elapsed milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "phase": {
            "description": "Phase name.",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "elapsed_ms"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `scan`.",
    "properties": {
      "completeness": {
        "$ref": "#/$defs/Completeness",
        "description": "Whether every root was read."
      },
      "lock_only": {
        "default": [],
        "description": "Ledger entries whose skill folder is absent from disk.",
        "items": {
          "$ref": "#/$defs/LockOnlySkill"
        },
        "type": "array"
      },
      "observations": {
        "description": "Notes about skipped roots and other facts.",
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "type": "array"
      },
      "projects": {
        "description": "Projects that were covered, sorted by canonical path.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      },
      "skills": {
        "description": "Skills sorted by name.",
        "items": {
          "$ref": "#/$defs/InstalledSkillDto"
        },
        "type": "array"
      },
      "timings": {
        "description": "Phase timings.",
        "items": {
          "$ref": "#/$defs/Timing"
        },
        "type": "array"
      },
      "unread_roots": {
        "default": [],
        "description": "Every path prefix this run could not read: a whole root (a budget\noverrun before the root was reached, or a `read_dir` error on the\nroot itself), or a single skill directory whose `SKILL.md` was\nunreadable within an otherwise-readable root - the set a caller\nmerging this result into a previous one must scope a carried-over\ndeployment to.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      }
    },
    "required": [
      "skills",
      "projects",
      "completeness",
      "observations",
      "timings"
    ],
    "title": "Inventory",
    "type": "object"
  },
  "crates/skill-studio-core/schema/invocation_report.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "InvocationDeployment": {
        "description": "One harness reading an installed copy.",
        "properties": {
          "deployment_id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Installed copy identity."
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Harness that reads this copy."
          },
          "mode": {
            "$ref": "#/$defs/InvocationMode",
            "description": "Mode this harness reads."
          },
          "path": {
            "description": "Copy directory.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "deployment_id",
          "harness",
          "path",
          "mode"
        ],
        "type": "object"
      },
      "InvocationMode": {
        "description": "Effective model invocation support for one harness.",
        "oneOf": [
          {
            "const": "manual",
            "description": "Only explicit invocation.",
            "type": "string"
          },
          {
            "const": "auto",
            "description": "Model invocation is allowed.",
            "type": "string"
          },
          {
            "const": "unsupported",
            "description": "No verified skill-owned control.",
            "type": "string"
          }
        ]
      },
      "SkillInvocationReport": {
        "description": "Invocation agreement across a skill's copies.",
        "properties": {
          "deployments": {
            "description": "Per-harness modes.",
            "items": {
              "$ref": "#/$defs/InvocationDeployment"
            },
            "type": "array"
          },
          "mismatch": {
            "description": "One harness reads this skill as auto and another as manual; `unsupported` does not count.",
            "type": "boolean"
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "Installed skill name."
          }
        },
        "required": [
          "skill",
          "deployments",
          "mismatch"
        ],
        "type": "object"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Scope invocation report and undo event ids.",
    "properties": {
      "event_ids": {
        "description": "Changes that can be undone through `restore_event`.",
        "items": {
          "$ref": "#/$defs/EventId"
        },
        "type": "array"
      },
      "skills": {
        "description": "Checked skills.",
        "items": {
          "$ref": "#/$defs/SkillInvocationReport"
        },
        "type": "array"
      }
    },
    "required": [
      "skills",
      "event_ids"
    ],
    "title": "InvocationReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/invocation_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "InvocationPolicy": {
        "description": "The three invocation-control states a skill's frontmatter can express.",
        "oneOf": [
          {
            "const": "both",
            "description": "Both explicit (`/name`) and model auto-invoke are available.",
            "type": "string"
          },
          {
            "const": "user-only",
            "description": "`disable-model-invocation: true` - explicit invocation only.",
            "type": "string"
          },
          {
            "const": "model-only",
            "description": "`user-invocable: false` - model auto-invoke only.",
            "type": "string"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Check a scope or set invocation for one skill.",
    "properties": {
      "deployment_id": {
        "anyOf": [
          {
            "$ref": "#/$defs/DeploymentId"
          },
          {
            "type": "null"
          }
        ],
        "description": "Desktop edits one exact copy."
      },
      "policy": {
        "anyOf": [
          {
            "$ref": "#/$defs/InvocationPolicy"
          },
          {
            "type": "null"
          }
        ],
        "description": "Absent checks only. A policy writes all copies of the named skill."
      },
      "skill": {
        "anyOf": [
          {
            "$ref": "#/$defs/SkillName"
          },
          {
            "type": "null"
          }
        ],
        "description": "Name filter; required for writes."
      }
    },
    "title": "InvocationRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/list_events_request.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `list_events`.",
    "properties": {
      "after": {
        "anyOf": [
          {
            "$ref": "#/$defs/EventId"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Pagination cursor: return only rows older than this event. Pass the\nlast id of the previous page. Ids are ULIDs, so \"older\" is \"sorts\nbefore\"."
      },
      "check_drift": {
        "default": false,
        "description": "Compare live fingerprints with the recorded ones and fill `drift`.\nCosts one read per touched path; `false` leaves `Unchecked`.",
        "type": "boolean"
      },
      "limit": {
        "default": 0,
        "description": "Maximum rows; `0` means the core default.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "skill": {
        "anyOf": [
          {
            "$ref": "#/$defs/SkillName"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Restrict to one skill."
      }
    },
    "title": "ListEventsRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/listing_report.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "ConfiguredListingModel": {
        "description": "Model selection from the winning config layer.",
        "properties": {
          "file": {
            "description": "Settings layer that supplied the value.",
            "type": "string",
            "x-untrusted": true
          },
          "name": {
            "description": "Model id or alias, as written.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "file"
        ],
        "type": "object"
      },
      "HarnessListing": {
        "description": "One harness listing in one scope.",
        "properties": {
          "base_prompt_skills": {
            "description": "Rendered base prompt skills section, including markup and file locations.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "budget": {
            "description": "Budget when this report computed one for the client.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "budget_source": {
            "description": "How the budget was resolved.",
            "type": "string",
            "x-untrusted": true
          },
          "budget_unit": {
            "description": "`characters` or `tokens` (UTF-8 bytes divided by four).",
            "type": "string"
          },
          "configured_model": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConfiguredListingModel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Configured model, independent of the model in the last recorded session."
          },
          "context_source": {
            "description": "Where the context window came from.",
            "type": "string",
            "x-untrusted": true
          },
          "context_window_tokens": {
            "description": "Context window in tokens, when known.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "description_char_limit": {
            "description": "The most characters of one description the agent lists: Claude Code's\nskillListingMaxDescChars in this scope, or Codex's fixed cap.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "description_limit_setting": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingSetting"
              },
              {
                "type": "null"
              }
            ],
            "description": "The layer controlling the Claude Code per-skill cap, independent of its total budget."
          },
          "entries": {
            "description": "Entries in listing order; hidden entries last.",
            "items": {
              "$ref": "#/$defs/ListingEntry"
            },
            "type": "array"
          },
          "evidence": {
            "$ref": "#/$defs/ListingEvidence",
            "default": "discovery",
            "description": "How this listing was produced."
          },
          "full_size": {
            "description": "Full preview size in `budget_unit`, or an estimate from discovered metadata for discovery rows.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Harness id."
          },
          "notes": {
            "description": "What Skill Studio infers instead of reading.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "observed_session": {
            "anyOf": [
              {
                "$ref": "#/$defs/ObservedSession"
              },
              {
                "type": "null"
              }
            ],
            "description": "The session that supplied `observed` states."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Project sessions include global skills."
          },
          "setting": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingSetting"
              },
              {
                "type": "null"
              }
            ],
            "description": "The setting that controls the budget."
          },
          "thresholds": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingThresholds"
              },
              {
                "type": "null"
              }
            ],
            "description": "The costs that decide which tier the listing is in, when the\nharness has tiers (Codex)."
          },
          "uses_default_context_window": {
            "description": "True when no model or context size was found.",
            "type": "boolean"
          }
        },
        "required": [
          "harness",
          "scope",
          "budget_unit",
          "full_size",
          "budget_source",
          "context_source",
          "uses_default_context_window",
          "notes",
          "entries"
        ],
        "type": "object"
      },
      "ListingDescription": {
        "description": "Wording from the local skill after the harness applies its listing limits.",
        "properties": {
          "remainder": {
            "description": "Original text beyond the cutoff.",
            "type": "string",
            "x-untrusted": true
          },
          "shown": {
            "description": "The description in the estimated listing.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "shown",
          "remainder"
        ],
        "type": "object"
      },
      "ListingEntry": {
        "description": "One skill in one harness listing.",
        "properties": {
          "description_preview": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingDescription"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact text for scanned Claude Code and Codex skills with a description."
          },
          "full_description_chars": {
            "description": "Description characters before any cut.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "hidden_reason": {
            "description": "Why a hidden skill is hidden.",
            "type": [
              "string",
              "null"
            ]
          },
          "invocation_mismatch": {
            "description": "Set when another agent's invocation setting disagrees with this one,\nsuch as a skill Claude Code keeps manual-only that Codex still lists.\nHolds the skill name.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "name": {
            "description": "Name as the harness lists it. Claude Code prefixes plugin skills.",
            "type": "string",
            "x-untrusted": true
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingState"
              },
              {
                "type": "null"
              }
            ],
            "description": "State in the last recorded session, when one was found."
          },
          "observed_description_chars": {
            "description": "Description characters in the last recorded session, when one was\nfound and the harness records them (Codex).",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "Deployment folder. Null for entries known only from a session.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "plugin": {
            "description": "Plugin identified by the scanner. Other entries come from a skill folder or session.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "scanned": {
            "description": "False for entries Skill Studio does not scan, such as bundled skills.",
            "type": "boolean"
          },
          "shown_description_chars": {
            "description": "Description characters in the preview, or in the discovered metadata for discovery rows.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "$ref": "#/$defs/ListingState",
            "description": "Model listing state for a preview. For discovery, describes the scanned entry only."
          },
          "usage_score": {
            "description": "Claude Code's usage score: uses times a 7-day half-life decay, at least 10%.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "state",
          "shown_description_chars",
          "full_description_chars",
          "scanned"
        ],
        "type": "object"
      },
      "ListingEvidence": {
        "description": "Evidence behind the current listing row. Session captures are reported independently.",
        "oneOf": [
          {
            "const": "discovery",
            "description": "Discovered deployments and their descriptions.",
            "type": "string"
          },
          {
            "const": "preview",
            "description": "A prediction produced by a supported client renderer.",
            "type": "string"
          }
        ]
      },
      "ListingSetting": {
        "description": "The setting that controls the budget, and how to change it.",
        "properties": {
          "chezmoi_source": {
            "description": "chezmoi source file when chezmoi manages `file`: edit this one, or\nchezmoi reverts the change.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "current": {
            "description": "Current value, when set.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "edit_revision": {
            "description": "Revision needed for an in-app edit. Absent for managed, linked and read-only settings.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "File to edit.",
            "type": "string",
            "x-untrusted": true
          },
          "key": {
            "description": "Setting key.",
            "type": "string"
          },
          "snippet": {
            "description": "The text to put in `file` for the requested budget.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "key",
          "file",
          "snippet"
        ],
        "type": "object"
      },
      "ListingState": {
        "description": "What one harness shows the model for one skill.",
        "oneOf": [
          {
            "const": "described",
            "description": "Name and full description.",
            "type": "string"
          },
          {
            "const": "truncated",
            "description": "Name and a shortened description.",
            "type": "string"
          },
          {
            "const": "name_only",
            "description": "Name only.",
            "type": "string"
          },
          {
            "const": "omitted",
            "description": "Not listed: the budget ran out.",
            "type": "string"
          },
          {
            "const": "hidden",
            "description": "Not listed: manual-only, off, parked, or rejected.",
            "type": "string"
          }
        ]
      },
      "ListingThresholds": {
        "description": "The listing costs, in the listing's `budget_unit`.",
        "properties": {
          "average_description_chars": {
            "description": "Average description characters each listed skill keeps.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "average_line_cost": {
            "description": "Average cost of one more name-and-path line.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "cap": {
            "description": "The highest budget the setting accepts.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "full_cost": {
            "description": "Cost with every description whole.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "names_only_cost": {
            "description": "Cost with names and paths only.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "roots_table_cost": {
            "description": "Cost of the skill roots table that short paths need; included in\nboth costs above.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "summary": {
            "description": "The tier and the distance to the next one, in plain words.",
            "type": "string"
          },
          "tier": {
            "$ref": "#/$defs/ListingTier",
            "description": "The tier the budget puts the listing in."
          }
        },
        "required": [
          "tier",
          "full_cost",
          "names_only_cost",
          "roots_table_cost",
          "average_line_cost",
          "average_description_chars",
          "summary"
        ],
        "type": "object"
      },
      "ListingTier": {
        "description": "Which of Codex's three listing forms applies.",
        "oneOf": [
          {
            "const": "all_described",
            "description": "Every description is whole.",
            "type": "string"
          },
          {
            "const": "descriptions_shortened",
            "description": "Every skill is listed; descriptions are cut to about the same length.",
            "type": "string"
          },
          {
            "const": "names_only",
            "description": "No descriptions; skills past the budget are left out.",
            "type": "string"
          }
        ]
      },
      "ObservedSession": {
        "description": "The session the observed states come from.",
        "properties": {
          "at": {
            "description": "Time of the listing, as recorded.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "described": {
            "description": "Entries with a description.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "listed": {
            "description": "Entries in that listing.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "description": "Model id that answered in that session.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "transcript": {
            "description": "Transcript file.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "transcript",
          "listed",
          "described"
        ],
        "type": "object"
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every harness listing for the global scope and the requested project.",
    "properties": {
      "listings": {
        "description": "Rows in scope, then harness, order.",
        "items": {
          "$ref": "#/$defs/HarnessListing"
        },
        "type": "array"
      }
    },
    "required": [
      "listings"
    ],
    "title": "ListingReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/listing_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `listing`.",
    "properties": {
      "claude_budget_fraction": {
        "description": "Predict Claude Code at this `skillListingBudgetFraction` (0 to 1).",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "claude_context_window_tokens": {
        "description": "Predict Claude Code with this context window in tokens.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "claude_transcript": {
        "description": "Compare Claude Code with this session transcript instead of the newest one.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "codex_max_context_tokens": {
        "description": "Predict Codex at this `skills.max_context_tokens` (capped at 10000).",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "codex_transcript": {
        "default": null,
        "description": "Compare Codex with this session rollout (`.codex/sessions/**/rollout-*.jsonl`)\ninstead of the newest one. Its listing also decides which plugins\nCodex loaded and the alias order.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "project_path": {
        "description": "Also report this project. It must be in the runtime scope.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      }
    },
    "title": "ListingRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/outdated_result.schema.json": {
    "$defs": {
      "Currency": {
        "description": "One skill's currency, keyed by name in [`outdated`]'s result. Wire-visible:\n`ops::outdated`'s CLI subcommand and MCP tool return this map directly.",
        "oneOf": [
          {
            "const": "up_to_date",
            "description": "The installed side matches the newest side.",
            "type": "string"
          },
          {
            "const": "update_available",
            "description": "The installed side is behind the newest side.",
            "type": "string"
          },
          {
            "const": "not_tracked",
            "description": "No install method claims this skill: manual, in-repo, an ambiguous\nowner, or a fork with no registry row (or no recorded upstream).\nNever shown as \"update available\".",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "A method claims the skill but the check could not run: a missing\nlock/ledger entry, a malformed lock file, or a lookup failure.\nDistinct from `NotTracked` so the UI can tell \"we don't know\" from\n\"there is nothing to know\" - and, per the crash test below, a\nmalformed lock file must resolve every skills.sh skill to `Unknown`,\nnever silently to `UpToDate` or `UpdateAvailable`.",
            "type": "string"
          },
          {
            "const": "missing_on_disk",
            "description": "A lock file lists the skill, but its folder is missing.",
            "type": "string"
          }
        ]
      },
      "OutdatedRecord": {
        "description": "One skill's full currency result, keyed by name in [`outdated`]'s result.\nWire-visible: `ops::outdated`'s CLI subcommand and MCP tool return this\nmap directly. Carries the compared pair alongside [`Currency`] so a\ncaller can show what changed, not just that it did.",
        "properties": {
          "currency": {
            "$ref": "#/$defs/Currency",
            "description": "The currency rule's verdict."
          },
          "error": {
            "description": "Why the lookup could not confirm currency, when `currency` is\n[`Currency::Unknown`] because of a lookup failure rather than a\nmissing lock/ledger entry. `None` otherwise.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "installed_commit": {
            "description": "The installed side: a dotagents pinned commit SHA, or a skills.sh\n`skillFolderHash`. `None` when the currency rule never resolved an\ninstalled side (`NotTracked`, or `Unknown` before the lock/ledger\nentry was found).",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "latest_commit": {
            "description": "The newest side: a dotagents commit SHA, or a skills.sh tree SHA for\nthat folder. `None` on the same conditions as `installed_commit`, or\nwhen the lookup failed.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "latest_commit_at": {
            "description": "The newest commit's date, dotagents only - `None` for skills.sh\n(tree SHAs carry no date) and whenever `latest_commit` is `None`.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          }
        },
        "required": [
          "currency"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": {
      "$ref": "#/$defs/OutdatedRecord"
    },
    "title": "Map_of_OutdatedRecord",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_action_report.schema.json": {
    "$defs": {
      "ErrorCode": {
        "description": "Stable error code.\n\nInvariant: the serialized name (`snake_case`) and the exit status of a\nvariant never change once released. New variants may be added.",
        "oneOf": [
          {
            "const": "invalid_request",
            "description": "The request itself is malformed (missing field, bad id syntax).",
            "type": "string"
          },
          {
            "const": "invalid_scope",
            "description": "The scope cannot be used (missing home, override outside fixture mode).",
            "type": "string"
          },
          {
            "const": "ambiguous_target",
            "description": "A target id matched more than one deployment or none after re-validation.",
            "type": "string"
          },
          {
            "const": "unsupported",
            "description": "The harness has no support for the requested mechanism.",
            "type": "string"
          },
          {
            "const": "backup_expired",
            "description": "Retention has expired the backup needed to undo an event.",
            "type": "string"
          },
          {
            "const": "execution_failed",
            "description": "A child process or external tool failed.",
            "type": "string"
          },
          {
            "const": "io",
            "description": "A filesystem or store read or write failed.",
            "type": "string"
          },
          {
            "const": "scope_busy",
            "description": "Another process holds the lease and the wait budget ran out.",
            "type": "string"
          },
          {
            "const": "stale_proposal",
            "description": "The proposal fingerprint no longer matches the file on disk.",
            "type": "string"
          },
          {
            "const": "drift_conflict",
            "description": "The live content drifted from the fingerprint recorded in history.",
            "type": "string"
          },
          {
            "const": "ownership_changed",
            "description": "The owner of the deployment changed between preview and apply.",
            "type": "string"
          },
          {
            "const": "already_reverted",
            "description": "The event was already reverted by another restore.",
            "type": "string"
          },
          {
            "const": "recovery_pending",
            "description": "An interrupted write is not recovered yet, so no new write ran.",
            "type": "string"
          },
          {
            "const": "incomplete",
            "description": "The operation finished but some roots could not be read in time.",
            "type": "string"
          },
          {
            "const": "cancelled",
            "description": "The caller cancelled the operation.",
            "type": "string"
          }
        ]
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "PackStep": {
        "description": "One skill in a pack action.",
        "properties": {
          "action": {
            "$ref": "#/$defs/PackStepAction",
            "description": "What the step does."
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Global or one project."
          },
          "skill": {
            "description": "Skill name.",
            "type": "string",
            "x-untrusted": true
          },
          "source": {
            "description": "Pack source.",
            "type": "string",
            "x-untrusted": true
          },
          "state": {
            "$ref": "#/$defs/PackStepState",
            "description": "Where the step is."
          }
        },
        "required": [
          "source",
          "skill",
          "scope",
          "action",
          "state"
        ],
        "type": "object"
      },
      "PackStepAction": {
        "description": "What one step does to one skill.",
        "oneOf": [
          {
            "const": "install",
            "description": "Install the skill.",
            "type": "string"
          },
          {
            "const": "update",
            "description": "Update the skill from its source.",
            "type": "string"
          },
          {
            "const": "remove",
            "description": "Remove the skill.",
            "type": "string"
          },
          {
            "const": "switch_source",
            "description": "Install the skill from another source over its current copy.",
            "type": "string"
          }
        ]
      },
      "PackStepState": {
        "description": "Where one step is.",
        "oneOf": [
          {
            "description": "Dry run: the step would run.",
            "properties": {
              "state": {
                "const": "planned",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The step ran. `restore_event` with this event undoes it.",
            "properties": {
              "event_id": {
                "$ref": "#/$defs/EventId",
                "description": "The per-skill journal event."
              },
              "state": {
                "const": "done",
                "type": "string"
              }
            },
            "required": [
              "state",
              "event_id"
            ],
            "type": "object"
          },
          {
            "description": "The step does not run.",
            "properties": {
              "reason": {
                "description": "Why, in one sentence.",
                "type": "string"
              },
              "state": {
                "const": "skipped",
                "type": "string"
              }
            },
            "required": [
              "state",
              "reason"
            ],
            "type": "object"
          },
          {
            "description": "The step ran and failed.",
            "properties": {
              "code": {
                "$ref": "#/$defs/ErrorCode",
                "description": "Stable code of the failure."
              },
              "reason": {
                "description": "The per-skill op's message, with any child process output.",
                "type": "string",
                "x-untrusted": true
              },
              "state": {
                "const": "failed",
                "type": "string"
              }
            },
            "required": [
              "state",
              "code",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `pack_add`, `pack_update`, and `pack_remove`.",
    "properties": {
      "dry_run": {
        "description": "The call changed nothing.",
        "type": "boolean"
      },
      "steps": {
        "description": "One step per skill.",
        "items": {
          "$ref": "#/$defs/PackStep"
        },
        "type": "array"
      },
      "summary": {
        "description": "One line for a person or agent.",
        "type": "string"
      }
    },
    "required": [
      "dry_run",
      "steps",
      "summary"
    ],
    "title": "PackActionReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_add_request.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_add`.",
    "properties": {
      "dry_run": {
        "default": false,
        "description": "Return the plan and change nothing.",
        "type": "boolean"
      },
      "harnesses": {
        "default": [],
        "description": "Agents to link, in the `skills` CLI's `--agent` spelling. Every skill\nalso gets the shared `.agents/skills` copy that update and remove use.\nEmpty: the shared copy only.",
        "items": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "type": "array"
      },
      "project_path": {
        "default": null,
        "description": "Install into this tracked project. Absent: the home.",
        "type": [
          "string",
          "null"
        ]
      },
      "ref_pin": {
        "default": null,
        "description": "Branch, tag, or commit to pin the pack to.",
        "type": [
          "string",
          "null"
        ]
      },
      "skills": {
        "default": [],
        "description": "Skills to install. Empty: every skill of the pack that is not\ninstalled yet, which needs git access to list them.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "source": {
        "description": "Git source as `npx skills add` takes it: `owner/repo` or a git URL.",
        "type": "string"
      }
    },
    "required": [
      "source"
    ],
    "title": "PackAddRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_export_report.schema.json": {
    "$defs": {
      "PackExportSkill": {
        "description": "One skill in the pack.",
        "properties": {
          "files": {
            "description": "How many files it holds.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "from": {
            "description": "The installed copy its files come from.",
            "type": "string",
            "x-untrusted": true
          },
          "skill": {
            "description": "Skill name, and its folder under `skills/`.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "skill",
          "from",
          "files"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `pack_export`.",
    "properties": {
      "dir": {
        "description": "The pack folder.",
        "type": "string",
        "x-untrusted": true
      },
      "dry_run": {
        "description": "The call wrote nothing.",
        "type": "boolean"
      },
      "files": {
        "description": "Every file written, or to write on a dry run, relative to `dir`.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      },
      "install_command": {
        "description": "The command that installs every skill of the pack once it is pushed.",
        "type": "string",
        "x-untrusted": true
      },
      "skills": {
        "description": "One entry per skill, in request order.",
        "items": {
          "$ref": "#/$defs/PackExportSkill"
        },
        "type": "array"
      },
      "summary": {
        "description": "One line for a person or agent.",
        "type": "string"
      }
    },
    "required": [
      "dry_run",
      "dir",
      "skills",
      "files",
      "install_command",
      "summary"
    ],
    "title": "PackExportReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_export_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_export`.",
    "properties": {
      "dir": {
        "description": "Absolute folder to create the pack in. It must not exist yet, or be\nan empty folder.",
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "description": "Return the plan and write nothing.",
        "type": "boolean"
      },
      "project_path": {
        "default": null,
        "description": "Take each skill's copy from this project, as the other pack ops\ntake `project_path`. Absent: the home.",
        "type": [
          "string",
          "null"
        ]
      },
      "skills": {
        "description": "Installed skills to put in the pack.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "source": {
        "default": null,
        "description": "Where the pack will live, as `owner/repo` or a git URL, for the\nREADME's install lines. Absent: the lines say `<owner>/<repo>`.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "dir",
      "skills"
    ],
    "title": "PackExportRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_list_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_list`.",
    "properties": {
      "project_path": {
        "default": null,
        "description": "Only this tracked project. Absent: the home and every tracked project.",
        "type": [
          "string",
          "null"
        ]
      },
      "remote": {
        "default": false,
        "description": "Ask each git source for its newest commit and skills. Off by default:\nwithout it the call reads local files only.",
        "type": "boolean"
      }
    },
    "title": "PackListRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_remove_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_remove`.",
    "properties": {
      "dry_run": {
        "default": false,
        "description": "Return the plan and change nothing.",
        "type": "boolean"
      },
      "project_path": {
        "default": null,
        "description": "Only this tracked project. Absent: the home and every tracked project.",
        "type": [
          "string",
          "null"
        ]
      },
      "source": {
        "description": "Pack source as `pack_list` reports it.",
        "type": "string"
      }
    },
    "required": [
      "source"
    ],
    "title": "PackRemoveRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_report.schema.json": {
    "$defs": {
      "Pack": {
        "description": "One source that ships installed skills.",
        "properties": {
          "behind_count": {
            "description": "Skills behind upstream.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "edited_count": {
            "description": "Skills with local edits.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "git_url": {
            "description": "Git URL the remote check uses.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "kind": {
            "$ref": "#/$defs/PackKind",
            "description": "The tool that installed it."
          },
          "new_upstream": {
            "description": "Upstream skills that are not installed. Empty without a remote check.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "original": {
            "anyOf": [
              {
                "$ref": "#/$defs/PackOriginal"
              },
              {
                "type": "null"
              }
            ],
            "description": "The source this pack's skills moved away from with\n`pack_switch_source`, such as the repo the pack's source is a fork\nof, and how the pack compares with it. Absent for a pack that never\nmoved."
          },
          "ref_pin": {
            "description": "Branch, tag, commit, or plugin version the install is pinned to.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "remote": {
            "$ref": "#/$defs/RemoteState",
            "description": "Remote check result."
          },
          "scopes": {
            "description": "Scopes with at least one skill of this pack.",
            "items": {
              "$ref": "#/$defs/RootScope"
            },
            "type": "array"
          },
          "skills": {
            "description": "Installed skills, by scope and name.",
            "items": {
              "$ref": "#/$defs/PackSkill"
            },
            "type": "array"
          },
          "source": {
            "description": "`owner/repo`, git URL, npm package, or `plugin@marketplace`.",
            "type": "string",
            "x-untrusted": true
          },
          "summary": {
            "description": "One line for a person or agent.",
            "type": "string",
            "x-untrusted": true
          },
          "update_commands": {
            "description": "Commands the owning agent runs to update this pack. Skill Studio does not run them.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "source",
          "kind",
          "update_commands",
          "scopes",
          "skills",
          "new_upstream",
          "edited_count",
          "behind_count",
          "remote",
          "summary"
        ],
        "type": "object"
      },
      "PackKind": {
        "description": "The tool that installed a pack.",
        "oneOf": [
          {
            "const": "skills_sh",
            "description": "`npx skills add` from a git source.",
            "type": "string"
          },
          {
            "const": "npm",
            "description": "`npx skills experimental_sync` from an npm package (`via` in `skills-lock.json`).",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "`npx @sentry/dotagents` skills and plugins.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A Claude Code or Codex plugin cache.",
            "type": "string"
          }
        ]
      },
      "PackOriginal": {
        "description": "The source a pack moved away from, and how the pack compares with it.",
        "properties": {
          "differs": {
            "description": "Installed skills whose folder in the original differs from the\nfolder in the pack's own source: one of the two changed it.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "not_in_source": {
            "description": "Skills of the original that the pack's own source does not have.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "remote": {
            "$ref": "#/$defs/RemoteState",
            "description": "`checked` only when the remote check read both the pack's own source\nand the original; otherwise the state of the read that did not happen\nor failed, and the two lists are empty."
          },
          "source": {
            "description": "The source the pack's skills came from before they moved to the\npack's own source.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "source",
          "remote",
          "differs",
          "not_in_source"
        ],
        "type": "object"
      },
      "PackSkill": {
        "description": "One installed skill of a pack, at one scope.",
        "properties": {
          "agents": {
            "description": "Agents that load this skill at this scope.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "behind": {
            "description": "Upstream has a different version. Absent: no remote check, or upstream lacks the skill.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "edited": {
            "description": "The folder differs from the hash its lock recorded. Absent: no hash to compare.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "description": "Skill name.",
            "type": "string",
            "x-untrusted": true
          },
          "path": {
            "description": "Installed folder, when one is on disk.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Global or one project."
          }
        },
        "required": [
          "name",
          "scope",
          "agents"
        ],
        "type": "object"
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RemoteState": {
        "description": "What the remote check found for one pack.",
        "oneOf": [
          {
            "description": "The call did not ask for a remote check.",
            "properties": {
              "state": {
                "const": "not_checked",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The pack has no git source to check.",
            "properties": {
              "state": {
                "const": "no_git_source",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The pack is pinned to one commit, so upstream cannot move.",
            "properties": {
              "state": {
                "const": "pinned_to_commit",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The source answered.",
            "properties": {
              "commit": {
                "description": "Upstream commit the check compared against.",
                "type": "string"
              },
              "state": {
                "const": "checked",
                "type": "string"
              }
            },
            "required": [
              "state",
              "commit"
            ],
            "type": "object"
          },
          {
            "description": "The source did not answer.",
            "properties": {
              "reason": {
                "description": "Git's own message.",
                "type": "string",
                "x-untrusted": true
              },
              "state": {
                "const": "failed",
                "type": "string"
              }
            },
            "required": [
              "state",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `pack_list` and `pack_show`.",
    "properties": {
      "packs": {
        "description": "Packs by kind, source, and pin.",
        "items": {
          "$ref": "#/$defs/Pack"
        },
        "type": "array"
      },
      "summary": {
        "description": "One line for a person or agent.",
        "type": "string"
      }
    },
    "required": [
      "packs",
      "summary"
    ],
    "title": "PackReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_show_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_show`.",
    "properties": {
      "project_path": {
        "default": null,
        "description": "Only this tracked project. Absent: the home and every tracked project.",
        "type": [
          "string",
          "null"
        ]
      },
      "remote": {
        "default": false,
        "description": "Ask the git source for its newest commit and skills.",
        "type": "boolean"
      },
      "source": {
        "description": "Pack source exactly as `pack_list` reports it.",
        "type": "string"
      }
    },
    "required": [
      "source"
    ],
    "title": "PackShowRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_switch_source_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_switch_source`.",
    "properties": {
      "dry_run": {
        "default": false,
        "description": "Return the plan and change nothing.",
        "type": "boolean"
      },
      "project_path": {
        "default": null,
        "description": "Only this tracked project. Absent: the home and every tracked project.",
        "type": [
          "string",
          "null"
        ]
      },
      "skills": {
        "default": [],
        "description": "Only these skills of the pack. Empty: every skill of the pack.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "source": {
        "description": "Pack source as `pack_list` reports it.",
        "type": "string"
      },
      "to": {
        "description": "Git source to install the skills from instead, usually your fork of\nthe pack: `owner/repo` or a git URL, with `#ref` to pin a branch or tag.",
        "type": "string"
      }
    },
    "required": [
      "source",
      "to"
    ],
    "title": "PackSwitchSourceRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/pack_update_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `pack_update`. Give `source` or `all`, not both.",
    "properties": {
      "all": {
        "default": false,
        "description": "Update every installed pack.",
        "type": "boolean"
      },
      "dry_run": {
        "default": false,
        "description": "Return the plan and change nothing.",
        "type": "boolean"
      },
      "project_path": {
        "default": null,
        "description": "Only this tracked project. Absent: the home and every tracked project.",
        "type": [
          "string",
          "null"
        ]
      },
      "source": {
        "default": null,
        "description": "Pack source as `pack_list` reports it.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "PackUpdateRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/park_outcome.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `park`.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The deployment that was parked."
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `park` event."
      },
      "parked_path": {
        "description": "Where the directory now lives, under the parked root.",
        "type": "string",
        "x-untrusted": true
      },
      "warnings": {
        "description": "Notes for the caller; never a reason the park failed. An adapter that\nran `park_check` first puts its git warning here.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      }
    },
    "required": [
      "event_id",
      "deployment_id",
      "parked_path"
    ],
    "title": "ParkOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/park_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to park one real copy: remove its per-harness links and move its\ndirectory into the parked root, in the slot for where it came from.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The copy to park: the Universal folder or an agent's own folder, at\nglobal or project scope. Never a link or a plugin copy."
      }
    },
    "required": [
      "deployment_id"
    ],
    "title": "ParkRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/recovery_drop_outcome.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "PlanId": {
        "description": "Journal plan id (ULID string).\n\nInvariant: lexical order equals creation order inside one journal.",
        "type": "string"
      },
      "PlanStatus": {
        "description": "Lifecycle state of one journal plan.\n\nInvariant: a row starts `Pending` (written before the plan's first step)\nand ends `Done`, `Failed`, `Reversed`, or `Dropped`; `Interrupted` and\n`Reversed` are the only states [`crate::journal::reconcile`] ever writes,\nand only for a row it found still `Pending` at startup - `Reversed` when\nit could undo every recorded step, `Interrupted` when undoing one failed.\nOnly `recovery drop` writes `Dropped`, and only over `Interrupted`.",
        "oneOf": [
          {
            "const": "pending",
            "description": "The manifest and plan are durable; steps have not all run yet.",
            "type": "string"
          },
          {
            "const": "done",
            "description": "Every step ran; the mutation is durable.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "Found `Pending` at startup with no step recorded, so there was\nnothing to undo.",
            "type": "string"
          },
          {
            "const": "reversed",
            "description": "Found `Pending` at startup and every recorded step was undone, in\nreverse order, through [`ScopeFs`].",
            "type": "string"
          },
          {
            "const": "interrupted",
            "description": "Found `Pending` at startup - the process died mid-plan - and\nundoing at least one recorded step hit an I/O error, so the plan's\non-disk state cannot be trusted as either the pre-plan or the\npost-plan shape.",
            "type": "string"
          },
          {
            "const": "dropped",
            "description": "The person gave up an `Interrupted` plan. Recovery no longer retries\nit, and its files stay as the last attempt left them.",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "A status that a newer build wrote and this build does not know.\nThis build leaves such a plan alone: it does not count it as open,\ndoes not settle or recover it, and keeps its backups, so a journal\nfrom a newer build never blocks writes here.",
            "type": "string"
          }
        ]
      },
      "RecoveryBackup": {
        "description": "A file a plan saved before it changed it.",
        "properties": {
          "original": {
            "description": "The file the copy came from.",
            "type": "string",
            "x-untrusted": true
          },
          "saved": {
            "description": "Where the saved copy is.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "original",
          "saved"
        ],
        "type": "object"
      },
      "RecoveryPlan": {
        "description": "One journal plan that recovery has not closed.",
        "properties": {
          "backups": {
            "description": "Saved copies of the files the write changed.",
            "items": {
              "$ref": "#/$defs/RecoveryBackup"
            },
            "type": "array"
          },
          "created_at": {
            "description": "When the write began.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/PlanId",
            "description": "The plan's ID, for `recovery drop`. Read from the journal folder name.",
            "x-untrusted": true
          },
          "label": {
            "description": "The write the plan belongs to.",
            "type": "string",
            "x-untrusted": true
          },
          "recovery_attempts": {
            "description": "Recovery runs that failed to undo the plan.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "recovery_error": {
            "description": "What the last failed run hit.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "root": {
            "description": "The folder the write ran under.",
            "type": "string",
            "x-untrusted": true
          },
          "status": {
            "$ref": "#/$defs/PlanStatus",
            "description": "`pending` until the next write tries to undo it, `interrupted` after a\nrun failed, `dropped` after `recovery drop`."
          },
          "touched_paths": {
            "description": "Paths the write touched. Each one can hold the old state, the new\nstate, or a half-done change.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          }
        },
        "required": [
          "id",
          "label",
          "created_at",
          "root",
          "status",
          "recovery_attempts",
          "touched_paths",
          "backups"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `recovery drop`.",
    "properties": {
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `recovery_plan_dropped` history event."
      },
      "plan": {
        "$ref": "#/$defs/RecoveryPlan",
        "description": "The plan as it is now, with what it may have left on disk."
      }
    },
    "required": [
      "event_id",
      "plan"
    ],
    "title": "RecoveryDropOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/recovery_drop_request.schema.json": {
    "$defs": {
      "PlanId": {
        "description": "Journal plan id (ULID string).\n\nInvariant: lexical order equals creation order inside one journal.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to give up one interrupted plan.",
    "properties": {
      "plan_id": {
        "$ref": "#/$defs/PlanId",
        "description": "ID from `recovery list`."
      }
    },
    "required": [
      "plan_id"
    ],
    "title": "RecoveryDropRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/recovery_report.schema.json": {
    "$defs": {
      "PlanId": {
        "description": "Journal plan id (ULID string).\n\nInvariant: lexical order equals creation order inside one journal.",
        "type": "string"
      },
      "PlanStatus": {
        "description": "Lifecycle state of one journal plan.\n\nInvariant: a row starts `Pending` (written before the plan's first step)\nand ends `Done`, `Failed`, `Reversed`, or `Dropped`; `Interrupted` and\n`Reversed` are the only states [`crate::journal::reconcile`] ever writes,\nand only for a row it found still `Pending` at startup - `Reversed` when\nit could undo every recorded step, `Interrupted` when undoing one failed.\nOnly `recovery drop` writes `Dropped`, and only over `Interrupted`.",
        "oneOf": [
          {
            "const": "pending",
            "description": "The manifest and plan are durable; steps have not all run yet.",
            "type": "string"
          },
          {
            "const": "done",
            "description": "Every step ran; the mutation is durable.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "Found `Pending` at startup with no step recorded, so there was\nnothing to undo.",
            "type": "string"
          },
          {
            "const": "reversed",
            "description": "Found `Pending` at startup and every recorded step was undone, in\nreverse order, through [`ScopeFs`].",
            "type": "string"
          },
          {
            "const": "interrupted",
            "description": "Found `Pending` at startup - the process died mid-plan - and\nundoing at least one recorded step hit an I/O error, so the plan's\non-disk state cannot be trusted as either the pre-plan or the\npost-plan shape.",
            "type": "string"
          },
          {
            "const": "dropped",
            "description": "The person gave up an `Interrupted` plan. Recovery no longer retries\nit, and its files stay as the last attempt left them.",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "A status that a newer build wrote and this build does not know.\nThis build leaves such a plan alone: it does not count it as open,\ndoes not settle or recover it, and keeps its backups, so a journal\nfrom a newer build never blocks writes here.",
            "type": "string"
          }
        ]
      },
      "RecoveryBackup": {
        "description": "A file a plan saved before it changed it.",
        "properties": {
          "original": {
            "description": "The file the copy came from.",
            "type": "string",
            "x-untrusted": true
          },
          "saved": {
            "description": "Where the saved copy is.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "original",
          "saved"
        ],
        "type": "object"
      },
      "RecoveryPlan": {
        "description": "One journal plan that recovery has not closed.",
        "properties": {
          "backups": {
            "description": "Saved copies of the files the write changed.",
            "items": {
              "$ref": "#/$defs/RecoveryBackup"
            },
            "type": "array"
          },
          "created_at": {
            "description": "When the write began.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/PlanId",
            "description": "The plan's ID, for `recovery drop`. Read from the journal folder name.",
            "x-untrusted": true
          },
          "label": {
            "description": "The write the plan belongs to.",
            "type": "string",
            "x-untrusted": true
          },
          "recovery_attempts": {
            "description": "Recovery runs that failed to undo the plan.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "recovery_error": {
            "description": "What the last failed run hit.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "root": {
            "description": "The folder the write ran under.",
            "type": "string",
            "x-untrusted": true
          },
          "status": {
            "$ref": "#/$defs/PlanStatus",
            "description": "`pending` until the next write tries to undo it, `interrupted` after a\nrun failed, `dropped` after `recovery drop`."
          },
          "touched_paths": {
            "description": "Paths the write touched. Each one can hold the old state, the new\nstate, or a half-done change.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          }
        },
        "required": [
          "id",
          "label",
          "created_at",
          "root",
          "status",
          "recovery_attempts",
          "touched_paths",
          "backups"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every plan recovery has not closed, oldest first.",
    "properties": {
      "plans": {
        "description": "Open plans. Empty when writes are not blocked.",
        "items": {
          "$ref": "#/$defs/RecoveryPlan"
        },
        "type": "array"
      }
    },
    "required": [
      "plans"
    ],
    "title": "RecoveryReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/remove_outcome.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `remove`.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The deployment that was removed."
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `remove` event."
      },
      "quarantine_path": {
        "description": "Where the folder now lives under quarantine, for `Copy`/`Fork`\n(never deleted - see `docs/flows.md`'s\nRemove row). `None` for `Dotagents`/`SkillsSh`, whose own CLI deletes\nthe bytes directly, the same as it does for every other build's\nremove today.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The skill that was removed."
      },
      "tree_hash_before": {
        "description": "The removed folder's `TreeHash`, taken before the first write.",
        "type": "string"
      }
    },
    "required": [
      "event_id",
      "deployment_id",
      "skill",
      "tree_hash_before"
    ],
    "title": "RemoveOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/remove_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to take one mutable deployment off disk.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The deployment to remove. Must resolve to a universal, canonical\ndeployment whose owner kind is mutable (`Copy`, `Fork`, `Dotagents`,\nor `SkillsSh`) - see [`crate::identity::LifecycleOwnerKind::is_mutable`]."
      }
    },
    "required": [
      "deployment_id"
    ],
    "title": "RemoveRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/repair_apply_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "Fingerprint": {
        "description": "Content fingerprint in the `sha256:<hex>` form.\n\nInvariant: the hex is lowercase and 64 characters long. One scheme covers\nfiles, trees, and proposals; the old untyped hex form is parsed on read.",
        "type": "string"
      },
      "FrontmatterRepairPreview": {
        "description": "A proposed frontmatter repair.\n\nInvariant: `apply_frontmatter_repair` refuses the proposal when the file\nno longer matches `expected_fingerprint` or the owner changed. The repair\nis deterministic: apply recomputes the proposal from the bytes on disk\nand compares `proposal_id`, so the caller's `proposed_content` is shown,\nnever written.",
        "properties": {
          "allowed_apply_modes": {
            "description": "Modes the caller may choose from.",
            "items": {
              "$ref": "#/$defs/RepairApplyMode"
            },
            "type": "array"
          },
          "deployment_id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Target deployment."
          },
          "diff": {
            "description": "Unified diff for a person.",
            "type": "string",
            "x-untrusted": true
          },
          "expected_fingerprint": {
            "$ref": "#/$defs/Fingerprint",
            "description": "Fingerprint of the current `SKILL.md` bytes."
          },
          "managed_update_warning": {
            "description": "Warning shown for [`RepairApplyMode::FixInstalledCopy`]: the next\nmanaged update overwrites the fix.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "original_content": {
            "description": "Current `SKILL.md` text, for a side-by-side view.",
            "type": "string",
            "x-untrusted": true
          },
          "owner_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/OwnerId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Owner at preview time."
          },
          "owner_kind": {
            "$ref": "#/$defs/LifecycleOwnerKind",
            "description": "Owner kind at preview time."
          },
          "path": {
            "description": "Absolute path of `SKILL.md`.",
            "type": "string",
            "x-untrusted": true
          },
          "proposal_id": {
            "$ref": "#/$defs/ProposalId",
            "description": "Proposal id."
          },
          "proposed_content": {
            "description": "Proposed `SKILL.md` text, for a side-by-side view.",
            "type": "string",
            "x-untrusted": true
          },
          "proposed_fingerprint": {
            "$ref": "#/$defs/Fingerprint",
            "description": "Fingerprint of the proposed bytes."
          },
          "reason": {
            "description": "Why the repair is proposed, for a person (the spec rule that fails).",
            "type": "string",
            "x-untrusted": true
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "Scope of the deployment's root."
          }
        },
        "required": [
          "proposal_id",
          "deployment_id",
          "path",
          "scope",
          "reason",
          "owner_kind",
          "expected_fingerprint",
          "proposed_fingerprint",
          "original_content",
          "proposed_content",
          "diff",
          "allowed_apply_modes"
        ],
        "type": "object"
      },
      "LifecycleOwnerKind": {
        "description": "Which ledger owns a deployment's lifecycle.",
        "oneOf": [
          {
            "const": "skills_sh",
            "description": "`~/.agents/.skill-lock.json`.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "A dotagents ledger.",
            "type": "string"
          },
          {
            "const": "copy",
            "description": "A copy install recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "fork",
            "description": "A fork recorded by Skill Studio.",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A harness plugin cache.",
            "type": "string"
          },
          {
            "const": "in_repo",
            "description": "Committed in the project repository.",
            "type": "string"
          },
          {
            "const": "manual",
            "description": "Placed by hand.",
            "type": "string"
          },
          {
            "const": "wildcard_dotagents",
            "description": "A dotagents wildcard entry.",
            "type": "string"
          },
          {
            "const": "ambiguous",
            "description": "More than one ledger claims the name.",
            "type": "string"
          }
        ]
      },
      "OwnerId": {
        "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
        "type": "string"
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "ProposalId": {
        "description": "Id of a frontmatter repair proposal.\n\nInvariant: sha256 over deployment id, path, owner id, owner kind, the\nexpected fingerprint, and the proposed text. Any change makes a new id.",
        "type": "string"
      },
      "RepairApplyMode": {
        "description": "Ways a frontmatter repair may be applied.",
        "oneOf": [
          {
            "const": "apply-fix",
            "description": "Rewrite the file in place.",
            "type": "string"
          },
          {
            "const": "fix-installed-copy",
            "description": "Rewrite the installed copy that a ledger owns.",
            "type": "string"
          },
          {
            "const": "fork-and-fix",
            "description": "Fork first, then rewrite the fork.",
            "type": "string"
          }
        ]
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `apply_frontmatter_repair`.",
    "properties": {
      "mode": {
        "$ref": "#/$defs/RepairApplyMode",
        "description": "Chosen mode; must be in `preview.allowed_apply_modes`."
      },
      "preview": {
        "$ref": "#/$defs/FrontmatterRepairPreview",
        "description": "The preview to apply, unchanged."
      }
    },
    "required": [
      "preview",
      "mode"
    ],
    "title": "RepairApplyRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/repair_outcome.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `apply_frontmatter_repair`.",
    "oneOf": [
      {
        "description": "The file was rewritten and an event recorded.",
        "properties": {
          "deployment_id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Deployment written (the fork for `ForkAndFix`)."
          },
          "event_id": {
            "$ref": "#/$defs/EventId",
            "description": "History event."
          },
          "outcome": {
            "const": "applied",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "event_id",
          "deployment_id"
        ],
        "type": "object"
      },
      {
        "description": "The file already had the proposed bytes; nothing was written.",
        "properties": {
          "deployment_id": {
            "$ref": "#/$defs/DeploymentId",
            "description": "Deployment inspected."
          },
          "outcome": {
            "const": "already_applied",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "deployment_id"
        ],
        "type": "object"
      }
    ],
    "title": "RepairOutcome"
  },
  "crates/skill-studio-core/schema/repair_preview_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `preview_frontmatter_repair`.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "Target deployment."
      }
    },
    "required": [
      "deployment_id"
    ],
    "title": "RepairPreviewRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/restore_outcome.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `restore_event`.",
    "properties": {
      "restore_event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The new `restore` event."
      },
      "restored_paths": {
        "description": "Paths put back.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      },
      "reverted_event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The event that was reverted."
      }
    },
    "required": [
      "restore_event_id",
      "reverted_event_id",
      "restored_paths"
    ],
    "title": "RestoreOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/restore_request.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `restore_event`.",
    "properties": {
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "Event to revert."
      },
      "force": {
        "default": false,
        "description": "Proceed on drift; the drifted bytes are backed up first.",
        "type": "boolean"
      }
    },
    "required": [
      "event_id"
    ],
    "title": "RestoreRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/review_due_report.schema.json": {
    "$defs": {
      "ReviewObservation": {
        "description": "History that could not be counted.",
        "properties": {
          "path": {
            "description": "Skipped file or root.",
            "type": "string",
            "x-untrusted": true
          },
          "reason": {
            "description": "Why this history is unavailable.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "type": "object"
      },
      "ReviewRow": {
        "description": "One skill past its review date.",
        "properties": {
          "review_date": {
            "description": "Saved date in YYYY-MM-DD form.",
            "type": "string"
          },
          "sessions": {
            "description": "Distinct sessions in the last 30 days, the `usage` default window.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "skill": {
            "description": "Skill name.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "skill",
          "review_date",
          "sessions"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Due skills with usage completeness facts.",
    "properties": {
      "observations": {
        "description": "All usage observations.",
        "items": {
          "$ref": "#/$defs/ReviewObservation"
        },
        "type": "array"
      },
      "partial": {
        "description": "Counts may miss sessions.",
        "type": "boolean"
      },
      "rows": {
        "description": "Skills sorted by name.",
        "items": {
          "$ref": "#/$defs/ReviewRow"
        },
        "type": "array"
      }
    },
    "required": [
      "rows",
      "partial",
      "observations"
    ],
    "title": "ReviewDueReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/review_outcome.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Saved review date after a set or clear.",
    "properties": {
      "review_date": {
        "description": "None after clear.",
        "type": [
          "string",
          "null"
        ]
      },
      "skill": {
        "description": "Installed skill name.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "required": [
      "skill"
    ],
    "title": "ReviewOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/review_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A named skill and its optional review date. No date clears the saved date.",
    "properties": {
      "date": {
        "description": "Calendar date in YYYY-MM-DD form.",
        "type": [
          "string",
          "null"
        ]
      },
      "skill": {
        "description": "Installed skill name.",
        "type": "string"
      }
    },
    "required": [
      "skill"
    ],
    "title": "ReviewRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/scan_request.schema.json": {
    "$defs": {
      "CopyStatus": {
        "description": "How an agent copy compares with the library copy in its scope.",
        "oneOf": [
          {
            "const": "link",
            "description": "A link that resolves to the library copy.",
            "type": "string"
          },
          {
            "const": "same",
            "description": "A real folder with the same files as the library copy.",
            "type": "string"
          },
          {
            "const": "differs",
            "description": "A real folder with other files, changed after the last install or\nupdate of the skill, or with no lock entry to compare with.",
            "type": "string"
          },
          {
            "const": "stale",
            "description": "A real folder with other files, all older than the last install or\nupdate in the lock file: the copy did not get that update.",
            "type": "string"
          }
        ]
      },
      "ScanRoot": {
        "description": "A scan root filter.",
        "oneOf": [
          {
            "const": "library",
            "description": "Skills directly in ~/.agents/skills.",
            "type": "string"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `scan`.",
    "properties": {
      "copy_status": {
        "anyOf": [
          {
            "$ref": "#/$defs/CopyStatus"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Keep only the agent copies with this copy status."
      },
      "root": {
        "anyOf": [
          {
            "$ref": "#/$defs/ScanRoot"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Restrict to the global shared library folder."
      },
      "skills": {
        "default": [],
        "description": "Restrict to these skill names; empty means all.",
        "items": {
          "$ref": "#/$defs/SkillName"
        },
        "type": "array"
      },
      "source": {
        "default": null,
        "description": "Restrict to this owner/repo, plugin@marketplace, or manual.",
        "type": [
          "string",
          "null"
        ]
      },
      "timings": {
        "default": false,
        "description": "Include per-phase timings.",
        "type": "boolean"
      }
    },
    "title": "ScanRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/skill_sessions_report.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "AgentSessions": {
        "description": "One agent's sessions and per-skill rollup.",
        "properties": {
          "captured_descriptions": {
            "description": "Distinct description strings read from this agent's saved listings, in first-seen order.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          },
          "doc": {
            "description": "The agent's skills documentation.",
            "type": [
              "string",
              "null"
            ]
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Agent id."
          },
          "note": {
            "description": "A description of reader coverage.",
            "type": "string"
          },
          "records": {
            "$ref": "#/$defs/SessionRecords",
            "description": "Session evidence supported by this reader."
          },
          "sessions_read": {
            "description": "Sessions read.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sessions_with_listing": {
            "description": "Sessions that recorded a listing.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sessions_with_miss": {
            "description": "Sessions with a possible miss.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sessions_with_use": {
            "description": "Sessions that used a skill.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "harness",
          "records",
          "note",
          "sessions_read",
          "sessions_with_listing",
          "sessions_with_use",
          "sessions_with_miss"
        ],
        "type": "object"
      },
      "ListingState": {
        "description": "What one harness shows the model for one skill.",
        "oneOf": [
          {
            "const": "described",
            "description": "Name and full description.",
            "type": "string"
          },
          {
            "const": "truncated",
            "description": "Name and a shortened description.",
            "type": "string"
          },
          {
            "const": "name_only",
            "description": "Name only.",
            "type": "string"
          },
          {
            "const": "omitted",
            "description": "Not listed: the budget ran out.",
            "type": "string"
          },
          {
            "const": "hidden",
            "description": "Not listed: manual-only, off, parked, or rejected.",
            "type": "string"
          }
        ]
      },
      "MissedSkill": {
        "description": "A skill the session may have needed but did not use. A guess.",
        "properties": {
          "listed_as": {
            "$ref": "#/$defs/SessionListingState",
            "description": "How this session listed the skill."
          },
          "score": {
            "description": "Match score of the first prompt against the description (BM25).",
            "format": "double",
            "type": "number"
          },
          "skill": {
            "description": "Skill name.",
            "type": "string",
            "x-untrusted": true
          },
          "words": {
            "description": "Prompt words, stemmed, that matched the description, best first.",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-untrusted": true
          }
        },
        "required": [
          "skill",
          "listed_as",
          "score",
          "words"
        ],
        "type": "object"
      },
      "SessionListedSkill": {
        "description": "One entry in a session's listing.",
        "properties": {
          "description_index": {
            "description": "Index into this agent's captured descriptions when the session contained wording.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "listed_as": {
            "$ref": "#/$defs/SessionListingState",
            "description": "How the session listed it."
          },
          "locator": {
            "description": "Client skill ID (`OpenCode`) or file location (pi), exactly as saved.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "skill": {
            "description": "Name as the session recorded it.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "skill",
          "listed_as"
        ],
        "type": "object"
      },
      "SessionListingState": {
        "description": "How one session showed one skill to the model.",
        "oneOf": [
          {
            "const": "described",
            "description": "Name and full description.",
            "type": "string"
          },
          {
            "const": "truncated",
            "description": "Name and a shortened description.",
            "type": "string"
          },
          {
            "const": "name_only",
            "description": "Name only. The model guesses from the name.",
            "type": "string"
          },
          {
            "const": "not_listed",
            "description": "Not in the listing. The model can find it only by path.",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "The session recorded no listing.",
            "type": "string"
          }
        ]
      },
      "SessionRecords": {
        "description": "Evidence Skill Studio can read from this agent\u2019s sessions.",
        "oneOf": [
          {
            "const": "listing_and_uses",
            "description": "The reader recognizes skill listings and skill uses.",
            "type": "string"
          },
          {
            "const": "uses_only",
            "description": "The reader recognizes skill uses. The Activity page counts them.",
            "type": "string"
          },
          {
            "const": "saved_guidance",
            "description": "Latest saved skill guidance. Use counts are available separately in Activity.",
            "type": "string"
          }
        ]
      },
      "SessionSkillUse": {
        "description": "One skill a session used.",
        "properties": {
          "listed_as": {
            "$ref": "#/$defs/SessionListingState",
            "description": "How this session listed the skill."
          },
          "skill": {
            "description": "Skill name, as the listing shows it when the listing has it.",
            "type": "string",
            "x-untrusted": true
          },
          "trigger": {
            "$ref": "#/$defs/SkillTrigger",
            "description": "How the first use started."
          }
        },
        "required": [
          "skill",
          "listed_as",
          "trigger"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "description": "One recorded session.",
        "properties": {
          "agent_name": {
            "description": "Selected agent within the client, when recorded.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "at": {
            "description": "Start time, as recorded.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "described": {
            "description": "Entries with a full or shortened description.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "entries": {
            "description": "Every listing entry, in listing order, as recorded.",
            "items": {
              "$ref": "#/$defs/SessionListedSkill"
            },
            "type": "array"
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Agent id."
          },
          "id": {
            "description": "The agent's session id.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "listed": {
            "description": "Entries in the listing.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "listing_recorded": {
            "description": "False when the session recorded no listing.",
            "type": "boolean"
          },
          "missed": {
            "description": "Possible misses. A guess, not a fact.",
            "items": {
              "$ref": "#/$defs/MissedSkill"
            },
            "type": "array"
          },
          "model": {
            "description": "Model id.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "name_only": {
            "description": "Entries with a name only.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "project_path": {
            "description": "Working folder.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "prompt": {
            "description": "Start of the first user prompt.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "transcript": {
            "description": "Transcript file.",
            "type": "string",
            "x-untrusted": true
          },
          "used": {
            "description": "Skills used, one row per skill.",
            "items": {
              "$ref": "#/$defs/SessionSkillUse"
            },
            "type": "array"
          }
        },
        "required": [
          "harness",
          "transcript",
          "listing_recorded",
          "listed",
          "described",
          "name_only",
          "entries",
          "used",
          "missed"
        ],
        "type": "object"
      },
      "SkillSessionFlag": {
        "description": "A finding about one skill across sessions.",
        "oneOf": [
          {
            "const": "listed_never_used",
            "description": "Listed in nearly every session, never used: it costs listing space.",
            "type": "string"
          },
          {
            "const": "used_while_name_only",
            "description": "Used in a session that listed it by name only.",
            "type": "string"
          },
          {
            "const": "possibly_missed",
            "description": "A session may have needed it and did not use it (a guess).",
            "type": "string"
          },
          {
            "const": "not_described_now",
            "description": "The current listing shows it by name only, leaves it out, or hides it.",
            "type": "string"
          },
          {
            "const": "not_reachable",
            "description": "Installed, but not in a folder this agent reads.",
            "type": "string"
          }
        ]
      },
      "SkillSessionRollup": {
        "description": "One skill across the sessions read.",
        "properties": {
          "described": {
            "description": "Sessions that listed it with its full description.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "flags": {
            "description": "Findings, most important first.",
            "items": {
              "$ref": "#/$defs/SkillSessionFlag"
            },
            "type": "array"
          },
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "Agent id."
          },
          "missed": {
            "description": "Sessions that may have missed it (a guess).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "Name as the agent lists it.",
            "type": "string",
            "x-untrusted": true
          },
          "name_only": {
            "description": "Sessions that listed it by name only.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "not_listed": {
            "description": "Sessions with a listing that did not list it.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "now": {
            "anyOf": [
              {
                "$ref": "#/$defs/ListingState"
              },
              {
                "type": "null"
              }
            ],
            "description": "The current listing prediction. Null when the agent does not read it\nor Skill Studio does not scan it."
          },
          "path": {
            "description": "Installed folder, when Skill Studio scans it.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "reach": {
            "description": "Why it is not described now, in plain words.",
            "type": [
              "string",
              "null"
            ],
            "x-untrusted": true
          },
          "truncated": {
            "description": "Sessions that listed it with a shortened description.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "used": {
            "description": "Sessions that used it.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "used_name_only": {
            "description": "Sessions that used it while it was listed by name only.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "used_not_listed": {
            "description": "Sessions that used it while it was not listed.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "harness",
          "name",
          "described",
          "truncated",
          "name_only",
          "not_listed",
          "used",
          "used_name_only",
          "used_not_listed",
          "missed",
          "flags"
        ],
        "type": "object"
      },
      "SkillTrigger": {
        "description": "How a skill use started.",
        "oneOf": [
          {
            "const": "user",
            "description": "The user typed the skill's command.",
            "type": "string"
          },
          {
            "const": "agent",
            "description": "The model called a skill tool.",
            "type": "string"
          },
          {
            "const": "file_read",
            "description": "The model read the skill's `SKILL.md` without a skill tool.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every agent's sessions.",
    "properties": {
      "agents": {
        "description": "Agents in catalog order.",
        "items": {
          "$ref": "#/$defs/AgentSessions"
        },
        "type": "array"
      },
      "history_days": {
        "description": "Days of history read.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "sessions": {
        "description": "Sessions, by agent, newest first.",
        "items": {
          "$ref": "#/$defs/SessionSummary"
        },
        "type": "array"
      },
      "skills": {
        "description": "Skills with findings first, then by agent and name.",
        "items": {
          "$ref": "#/$defs/SkillSessionRollup"
        },
        "type": "array"
      }
    },
    "required": [
      "skills",
      "sessions",
      "agents",
      "history_days"
    ],
    "title": "SkillSessionsReport",
    "type": "object"
  },
  "crates/skill-studio-core/schema/skill_sessions_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input for `skill_sessions`.",
    "properties": {
      "project_path": {
        "description": "Only sessions recorded in this project, and its skills. It must be in\nthe runtime scope.",
        "type": [
          "string",
          "null"
        ],
        "x-untrusted": true
      },
      "sessions": {
        "description": "Newest sessions to read per agent, at most 500. Default 100.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "title": "SkillSessionsRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/split_outcome.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "SplitCopy": {
        "description": "One folder `split` wrote.",
        "properties": {
          "harness": {
            "$ref": "#/$defs/AgentIdentity",
            "description": "The harness that reads this copy."
          },
          "path": {
            "description": "The copy's folder.",
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "harness",
          "path"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `split`.",
    "properties": {
      "copies": {
        "description": "One entry per chosen harness.",
        "items": {
          "$ref": "#/$defs/SplitCopy"
        },
        "type": "array"
      },
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The Universal deployment that was split."
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `split` event."
      },
      "quarantine_path": {
        "description": "Where the Universal folder was moved (quarantine), kept for undo.",
        "type": "string",
        "x-untrusted": true
      },
      "removed_links": {
        "description": "Links into the Universal folder that were removed.",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-untrusted": true
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The skill's name."
      },
      "update_note": {
        "description": "Plain-language note: `npx skills update` updates only a Universal\ncopy, so these copies no longer get updates from it.",
        "type": "string"
      }
    },
    "required": [
      "event_id",
      "deployment_id",
      "skill",
      "copies",
      "removed_links",
      "quarantine_path",
      "update_note"
    ],
    "title": "SplitOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/split_request.schema.json": {
    "$defs": {
      "AgentIdentity": {
        "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
        "type": "string"
      },
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to split one Universal deployment into per-harness copies.\n\nEvery harness in `harnesses` gets a real folder copy; every other\nharness that read the Universal folder loses the skill.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The Universal deployment to split."
      },
      "harnesses": {
        "description": "The harnesses that keep the skill. Must not be empty.",
        "items": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "type": "array"
      }
    },
    "required": [
      "deployment_id",
      "harnesses"
    ],
    "title": "SplitRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/sweep_quarantine_request.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request for `sweep_quarantine`. Empty: the op only ever sweeps the\nglobal root (see `ops::sweep_quarantine`'s own doc), so there is nothing\nfor a caller to choose yet.",
    "title": "SweepQuarantineRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/unpark_outcome.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      },
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `unpark`.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The deployment that was restored."
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `unpark` event."
      },
      "restored_path": {
        "description": "Where the directory now lives: the folder it was parked from.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "required": [
      "event_id",
      "deployment_id",
      "restored_path"
    ],
    "title": "UnparkOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/unpark_request.schema.json": {
    "$defs": {
      "DeploymentId": {
        "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to unpark one deployment: move its directory back to the\nuniversal root and recreate any per-harness link it had.",
    "properties": {
      "deployment_id": {
        "$ref": "#/$defs/DeploymentId",
        "description": "The parked deployment to restore."
      }
    },
    "required": [
      "deployment_id"
    ],
    "title": "UnparkRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/update_all_outcome.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "UpdateAllItem": {
        "description": "One skill's result inside an `update_all` batch.",
        "properties": {
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/$defs/UpdateOutcome"
              },
              {
                "type": "null"
              }
            ],
            "description": "`Some` on success, `None` when this skill's update failed - the\nfailure's message is the matching entry in\n[`UpdateAllOutcome::errors`]."
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "The skill this result is for."
          }
        },
        "required": [
          "skill"
        ],
        "type": "object"
      },
      "UpdateOutcome": {
        "description": "Result of `update`.",
        "properties": {
          "deployment_path": {
            "description": "Where its canonical folder lives.",
            "type": "string",
            "x-untrusted": true
          },
          "event_id": {
            "$ref": "#/$defs/EventId",
            "description": "The `update` event."
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "The skill that was updated."
          },
          "tree_hash_after": {
            "description": "The tree's git tree SHA after this update.",
            "type": "string"
          },
          "tree_hash_before": {
            "description": "The tree's git tree SHA before this update.",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "skill",
          "deployment_path",
          "tree_hash_before",
          "tree_hash_after"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `update_all`: one [`UpdateAllItem`] per requested skill, in the\norder each one finished (not the order requested), plus the message for\nany that failed.",
    "properties": {
      "errors": {
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "description": "`skill.0` -> error message, for every item whose `outcome` is `None`.",
        "type": "object",
        "x-untrusted": true
      },
      "items": {
        "description": "One entry per skill `update_all` was asked to refresh.",
        "items": {
          "$ref": "#/$defs/UpdateAllItem"
        },
        "type": "array"
      },
      "not_run": {
        "default": [],
        "description": "Skills never started because the batch's cancel token was set; they\nhave no entry in `items` or `errors`.",
        "items": {
          "$ref": "#/$defs/SkillName"
        },
        "type": "array"
      }
    },
    "required": [
      "items"
    ],
    "title": "UpdateAllOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/update_all_request.schema.json": {
    "$defs": {
      "InstallFile": {
        "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
        "properties": {
          "contents": {
            "description": "The file's bytes.",
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "mode": {
            "default": null,
            "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "relative_path": {
            "description": "Path relative to the skill folder's own root.",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "contents"
        ],
        "type": "object"
      },
      "InstallMethod": {
        "description": "Which of the three ways `ops::install` can put a skill's bytes on disk.",
        "oneOf": [
          {
            "const": "copy",
            "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "`npx -y @sentry/dotagents add <source>`.",
            "type": "string"
          },
          {
            "const": "skills_sh",
            "description": "`npx -y skills add <source>`.",
            "type": "string"
          }
        ]
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      },
      "UpdateRequest": {
        "description": "Request to refresh one already-installed skill in place, via\n`ops::update`. Reuses [`InstallMethod`]: `Copy` re-stages fresh `files`\nand swaps them in, quarantining the previous tree; `Dotagents`/`SkillsSh`\nre-run the same CLI `install` shelled out to, in place over the existing\ndestination.",
        "properties": {
          "files": {
            "default": [],
            "description": "`Copy` only: the fresh files to stage and swap in.",
            "items": {
              "$ref": "#/$defs/InstallFile"
            },
            "type": "array"
          },
          "method": {
            "$ref": "#/$defs/InstallMethod",
            "description": "Which method wrote the deployment being refreshed."
          },
          "ref_pin": {
            "default": null,
            "description": "`Dotagents` only: an already-resolved commit for a pinned\n(`declared_ref`) ledger entry - the caller's own concern, not\nre-derived here (see `ops_update`'s module doc). The update writes it\ninto that entry's `ref` before running `dotagents install`.",
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "$ref": "#/$defs/RootScope",
            "description": "`Global` updates the scope home; `Project` updates one project."
          },
          "skill": {
            "$ref": "#/$defs/SkillName",
            "description": "The already-installed skill's folder name."
          },
          "source": {
            "default": null,
            "description": "`Dotagents` only: must be present, but no longer reaches the CLI -\nthe update runs `dotagents install`, which reads the source from the\nscope's `agents.toml` entry (see `ops_update`'s module doc).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "skill",
          "method",
          "scope"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request wrapper for `ops::update_all` - the op itself takes a plain\n`&[UpdateRequest]`; this only exists so an MCP tool has one schema to\ndeclare instead of an array-of-objects root schema.",
    "properties": {
      "requests": {
        "description": "One request per skill to refresh, each its own journal entry; at most 100.",
        "items": {
          "$ref": "#/$defs/UpdateRequest"
        },
        "type": "array"
      }
    },
    "required": [
      "requests"
    ],
    "title": "UpdateAllRequest",
    "type": "object"
  },
  "crates/skill-studio-core/schema/update_outcome.schema.json": {
    "$defs": {
      "EventId": {
        "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
        "type": "string"
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Result of `update`.",
    "properties": {
      "deployment_path": {
        "description": "Where its canonical folder lives.",
        "type": "string",
        "x-untrusted": true
      },
      "event_id": {
        "$ref": "#/$defs/EventId",
        "description": "The `update` event."
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The skill that was updated."
      },
      "tree_hash_after": {
        "description": "The tree's git tree SHA after this update.",
        "type": "string"
      },
      "tree_hash_before": {
        "description": "The tree's git tree SHA before this update.",
        "type": "string"
      }
    },
    "required": [
      "event_id",
      "skill",
      "deployment_path",
      "tree_hash_before",
      "tree_hash_after"
    ],
    "title": "UpdateOutcome",
    "type": "object"
  },
  "crates/skill-studio-core/schema/update_request.schema.json": {
    "$defs": {
      "InstallFile": {
        "description": "One file `InstallMethod::Copy` stages into the new skill's folder, path\nrelative to the folder root (for example `SKILL.md` or\n`scripts/run.sh`).",
        "properties": {
          "contents": {
            "description": "The file's bytes.",
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "mode": {
            "default": null,
            "description": "The `0o777` permission bits the source file had, so a copied\n`scripts/run.sh` stays executable. `None` gives the process default;\nignored off Unix.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "relative_path": {
            "description": "Path relative to the skill folder's own root.",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "contents"
        ],
        "type": "object"
      },
      "InstallMethod": {
        "description": "Which of the three ways `ops::install` can put a skill's bytes on disk.",
        "oneOf": [
          {
            "const": "copy",
            "description": "Fetches or copies bytes and stages/swaps them into place directly -\nno external CLI.",
            "type": "string"
          },
          {
            "const": "dotagents",
            "description": "`npx -y @sentry/dotagents add <source>`.",
            "type": "string"
          },
          {
            "const": "skills_sh",
            "description": "`npx -y skills add <source>`.",
            "type": "string"
          }
        ]
      },
      "ProjectRef": {
        "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
        "type": "string",
        "x-untrusted": true
      },
      "RootScope": {
        "description": "Where a root lives.",
        "oneOf": [
          {
            "description": "Under the scope home.",
            "properties": {
              "scope": {
                "const": "global",
                "type": "string"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          {
            "description": "Under one tracked project.",
            "properties": {
              "project": {
                "$ref": "#/$defs/ProjectRef"
              },
              "scope": {
                "const": "project",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "project"
            ],
            "type": "object"
          }
        ]
      },
      "SkillName": {
        "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
        "type": "string",
        "x-untrusted": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request to refresh one already-installed skill in place, via\n`ops::update`. Reuses [`InstallMethod`]: `Copy` re-stages fresh `files`\nand swaps them in, quarantining the previous tree; `Dotagents`/`SkillsSh`\nre-run the same CLI `install` shelled out to, in place over the existing\ndestination.",
    "properties": {
      "files": {
        "default": [],
        "description": "`Copy` only: the fresh files to stage and swap in.",
        "items": {
          "$ref": "#/$defs/InstallFile"
        },
        "type": "array"
      },
      "method": {
        "$ref": "#/$defs/InstallMethod",
        "description": "Which method wrote the deployment being refreshed."
      },
      "ref_pin": {
        "default": null,
        "description": "`Dotagents` only: an already-resolved commit for a pinned\n(`declared_ref`) ledger entry - the caller's own concern, not\nre-derived here (see `ops_update`'s module doc). The update writes it\ninto that entry's `ref` before running `dotagents install`.",
        "type": [
          "string",
          "null"
        ]
      },
      "scope": {
        "$ref": "#/$defs/RootScope",
        "description": "`Global` updates the scope home; `Project` updates one project."
      },
      "skill": {
        "$ref": "#/$defs/SkillName",
        "description": "The already-installed skill's folder name."
      },
      "source": {
        "default": null,
        "description": "`Dotagents` only: must be present, but no longer reaches the CLI -\nthe update runs `dotagents install`, which reads the source from the\nscope's `agents.toml` entry (see `ops_update`'s module doc).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "skill",
      "method",
      "scope"
    ],
    "title": "UpdateRequest",
    "type": "object"
  }
}
