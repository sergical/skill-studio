{
  "schema_version": 1,
  "id": "report-control",
  "name": "Report skill versus no skill",
  "skill_path": "report-skill",
  "cases": [
    {
      "id": "report",
      "name": "Write a project report",
      "prompt": "Read input.txt and write report.md with a short report of the given facts. Do not use the internet or change any other files.",
      "mode": "discovery",
      "files": [
        {
          "path": "input.txt",
          "content": "Project Cedar shipped two fixes on Monday. One issue remains."
        }
      ],
      "checks": [
        {
          "id": "exists",
          "name": "Report exists",
          "assertion": {
            "kind": "file_exists",
            "path": "report.md"
          }
        },
        {
          "id": "facts",
          "name": "Includes the shipped fixes",
          "assertion": {
            "kind": "file_contains",
            "path": "report.md",
            "text": "two fixes"
          }
        },
        {
          "id": "workflow",
          "name": "Uses the source verification line",
          "assertion": {
            "kind": "file_contains",
            "path": "report.md",
            "text": "Verified from the source facts."
          }
        }
      ]
    }
  ],
  "variants": [
    {
      "id": "candidate",
      "name": "Current skill",
      "client": "pi",
      "model": null,
      "skill": {
        "kind": "candidate"
      }
    },
    {
      "id": "control",
      "name": "No skill",
      "client": "pi",
      "model": null,
      "skill": {
        "kind": "without_skill"
      }
    }
  ],
  "repetitions": 2,
  "timeout_seconds": 120,
  "judge": null
}
