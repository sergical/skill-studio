{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListingReport",
  "description": "Every harness listing for the global scope and the requested project.",
  "type": "object",
  "properties": {
    "listings": {
      "description": "Rows in scope, then harness, order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HarnessListing"
      }
    }
  },
  "required": [
    "listings"
  ],
  "$defs": {
    "HarnessListing": {
      "description": "One harness listing in one scope.",
      "type": "object",
      "properties": {
        "harness": {
          "description": "Harness id.",
          "$ref": "#/$defs/AgentIdentity"
        },
        "scope": {
          "description": "Project sessions include global skills.",
          "$ref": "#/$defs/RootScope"
        },
        "budget": {
          "description": "Budget, or null when the harness has no known limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "budget_unit": {
          "description": "`characters` or `tokens` (UTF-8 bytes divided by four).",
          "type": "string"
        },
        "full_size": {
          "description": "The whole listing with every description, in `budget_unit`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "budget_source": {
          "description": "How the budget was resolved.",
          "type": "string"
        },
        "context_window_tokens": {
          "description": "Context window in tokens, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_source": {
          "description": "Where the context window came from.",
          "type": "string"
        },
        "uses_default_context_window": {
          "description": "True when no model or context size was found.",
          "type": "boolean"
        },
        "notes": {
          "description": "What Skill Studio infers instead of reading.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setting": {
          "description": "The setting that controls the budget.",
          "anyOf": [
            {
              "$ref": "#/$defs/ListingSetting"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_session": {
          "description": "The session that supplied `observed` states.",
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedSession"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "description": "Entries in listing order; hidden entries last.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListingEntry"
          }
        }
      },
      "required": [
        "harness",
        "scope",
        "budget_unit",
        "full_size",
        "budget_source",
        "context_source",
        "uses_default_context_window",
        "notes",
        "entries"
      ]
    },
    "AgentIdentity": {
      "description": "Kebab-case harness identifier, for example `claude-code` or `opencode`.\n\nLegacy spellings are normalized at input boundaries.",
      "type": "string"
    },
    "RootScope": {
      "description": "Where a root lives.",
      "oneOf": [
        {
          "description": "Under the scope home.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "description": "Under one tracked project.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "project"
            },
            "project": {
              "$ref": "#/$defs/ProjectRef"
            }
          },
          "required": [
            "scope",
            "project"
          ]
        }
      ]
    },
    "ProjectRef": {
      "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
      "type": "string",
      "x-untrusted": true
    },
    "ListingSetting": {
      "description": "The setting that controls the budget, and how to change it.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Setting key.",
          "type": "string"
        },
        "current": {
          "description": "Current value, when set.",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "File to edit.",
          "type": "string",
          "x-untrusted": true
        },
        "chezmoi_source": {
          "description": "chezmoi source file when chezmoi manages `file`: edit this one, or\nchezmoi reverts the change.",
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true
        },
        "snippet": {
          "description": "The text to put in `file` for the requested budget.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "file",
        "snippet"
      ]
    },
    "ObservedSession": {
      "description": "The session the observed states come from.",
      "type": "object",
      "properties": {
        "transcript": {
          "description": "Transcript file.",
          "type": "string",
          "x-untrusted": true
        },
        "at": {
          "description": "Time of the listing, as recorded.",
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true
        },
        "model": {
          "description": "Model id that answered in that session.",
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true
        },
        "listed": {
          "description": "Entries in that listing.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "described": {
          "description": "Entries with a description.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "transcript",
        "listed",
        "described"
      ]
    },
    "ListingEntry": {
      "description": "One skill in one harness listing.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name as the harness lists it. Claude Code prefixes plugin skills.",
          "type": "string",
          "x-untrusted": true
        },
        "path": {
          "description": "Deployment folder. Null for entries known only from a session.",
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true
        },
        "state": {
          "description": "Predicted state.",
          "$ref": "#/$defs/ListingState"
        },
        "hidden_reason": {
          "description": "Why a hidden skill is hidden.",
          "type": [
            "string",
            "null"
          ]
        },
        "shown_description_chars": {
          "description": "Description characters the model sees.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "full_description_chars": {
          "description": "Description characters before any cut.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_score": {
          "description": "Claude Code's usage score: uses times a 7-day half-life decay, at least 10%.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "observed": {
          "description": "State in the last recorded session, when one was found.",
          "anyOf": [
            {
              "$ref": "#/$defs/ListingState"
            },
            {
              "type": "null"
            }
          ]
        },
        "scanned": {
          "description": "False for entries Skill Studio does not scan, such as bundled skills.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "state",
        "shown_description_chars",
        "full_description_chars",
        "scanned"
      ]
    },
    "ListingState": {
      "description": "What one harness shows the model for one skill.",
      "oneOf": [
        {
          "description": "Name and full description.",
          "type": "string",
          "const": "described"
        },
        {
          "description": "Name and a shortened description.",
          "type": "string",
          "const": "truncated"
        },
        {
          "description": "Name only.",
          "type": "string",
          "const": "name_only"
        },
        {
          "description": "Not listed: the budget ran out.",
          "type": "string",
          "const": "omitted"
        },
        {
          "description": "Not listed: manual-only, off, parked, or rejected.",
          "type": "string",
          "const": "hidden"
        }
      ]
    }
  }
}
