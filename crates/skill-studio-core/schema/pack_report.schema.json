{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackReport",
  "description": "Result of `pack_list` and `pack_show`.",
  "type": "object",
  "properties": {
    "packs": {
      "description": "Packs by kind, source, and pin.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pack"
      }
    },
    "summary": {
      "description": "One line for a person or agent.",
      "type": "string"
    }
  },
  "required": [
    "packs",
    "summary"
  ],
  "$defs": {
    "Pack": {
      "description": "One source that ships installed skills.",
      "type": "object",
      "properties": {
        "source": {
          "description": "`owner/repo`, git URL, npm package, or `plugin@marketplace`.",
          "type": "string"
        },
        "kind": {
          "description": "The tool that installed it.",
          "$ref": "#/$defs/PackKind"
        },
        "git_url": {
          "description": "Git URL the remote check uses.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref_pin": {
          "description": "Branch, tag, commit, or plugin version the install is pinned to.",
          "type": [
            "string",
            "null"
          ]
        },
        "update_commands": {
          "description": "Commands the owning agent runs to update this pack. Skill Studio does not run them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "description": "Scopes with at least one skill of this pack.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RootScope"
          }
        },
        "skills": {
          "description": "Installed skills, by scope and name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackSkill"
          }
        },
        "new_upstream": {
          "description": "Upstream skills that are not installed. Empty without a remote check.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edited_count": {
          "description": "Skills with local edits.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "behind_count": {
          "description": "Skills behind upstream.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "remote": {
          "description": "Remote check result.",
          "$ref": "#/$defs/RemoteState"
        },
        "summary": {
          "description": "One line for a person or agent.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "kind",
        "update_commands",
        "scopes",
        "skills",
        "new_upstream",
        "edited_count",
        "behind_count",
        "remote",
        "summary"
      ]
    },
    "PackKind": {
      "description": "The tool that installed a pack.",
      "oneOf": [
        {
          "description": "`npx skills add` from a git source.",
          "type": "string",
          "const": "skills_sh"
        },
        {
          "description": "`npx skills experimental_sync` from an npm package (`via` in `skills-lock.json`).",
          "type": "string",
          "const": "npm"
        },
        {
          "description": "`npx @sentry/dotagents` skills and plugins.",
          "type": "string",
          "const": "dotagents"
        },
        {
          "description": "A Claude Code or Codex plugin cache.",
          "type": "string",
          "const": "plugin"
        }
      ]
    },
    "RootScope": {
      "description": "Where a root lives.",
      "oneOf": [
        {
          "description": "Under the scope home.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "description": "Under one tracked project.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "project"
            },
            "project": {
              "$ref": "#/$defs/ProjectRef"
            }
          },
          "required": [
            "scope",
            "project"
          ]
        }
      ]
    },
    "ProjectRef": {
      "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
      "type": "string"
    },
    "PackSkill": {
      "description": "One installed skill of a pack, at one scope.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Skill name.",
          "type": "string"
        },
        "scope": {
          "description": "Global or one project.",
          "$ref": "#/$defs/RootScope"
        },
        "path": {
          "description": "Installed folder, when one is on disk.",
          "type": [
            "string",
            "null"
          ]
        },
        "agents": {
          "description": "Agents that load this skill at this scope.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edited": {
          "description": "The folder differs from the hash its lock recorded. Absent: no hash to compare.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "behind": {
          "description": "Upstream has a different version. Absent: no remote check, or upstream lacks the skill.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "scope",
        "agents"
      ]
    },
    "RemoteState": {
      "description": "What the remote check found for one pack.",
      "oneOf": [
        {
          "description": "The call did not ask for a remote check.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "not_checked"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "The pack has no git source to check.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "no_git_source"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "The pack is pinned to one commit, so upstream cannot move.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "pinned_to_commit"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "The source answered.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "checked"
            },
            "commit": {
              "description": "Upstream commit the check compared against.",
              "type": "string"
            }
          },
          "required": [
            "state",
            "commit"
          ]
        },
        {
          "description": "The source did not answer.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "failed"
            },
            "reason": {
              "description": "Git's own message.",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        }
      ]
    }
  }
}
