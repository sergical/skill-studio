{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairApplyRequest",
  "description": "Request for `apply_frontmatter_repair`.",
  "type": "object",
  "properties": {
    "preview": {
      "description": "The preview to apply, unchanged.",
      "$ref": "#/$defs/FrontmatterRepairPreview"
    },
    "mode": {
      "description": "Chosen mode; must be in `preview.allowed_apply_modes`.",
      "$ref": "#/$defs/RepairApplyMode"
    }
  },
  "required": [
    "preview",
    "mode"
  ],
  "$defs": {
    "FrontmatterRepairPreview": {
      "description": "A proposed frontmatter repair.\n\nInvariant: `apply_frontmatter_repair` refuses the proposal when the file\nno longer matches `expected_fingerprint` or the owner changed. The repair\nis deterministic: apply recomputes the proposal from the bytes on disk\nand compares `proposal_id`, so the caller's `proposed_content` is shown,\nnever written.",
      "type": "object",
      "properties": {
        "proposal_id": {
          "description": "Proposal id.",
          "$ref": "#/$defs/ProposalId"
        },
        "deployment_id": {
          "description": "Target deployment.",
          "$ref": "#/$defs/DeploymentId"
        },
        "path": {
          "description": "Absolute path of `SKILL.md`.",
          "type": "string"
        },
        "scope": {
          "description": "Scope of the deployment's root.",
          "$ref": "#/$defs/RootScope"
        },
        "reason": {
          "description": "Why the repair is proposed, for a person (the spec rule that fails).",
          "type": "string"
        },
        "owner_id": {
          "description": "Owner at preview time.",
          "anyOf": [
            {
              "$ref": "#/$defs/OwnerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_kind": {
          "description": "Owner kind at preview time.",
          "$ref": "#/$defs/LifecycleOwnerKind"
        },
        "expected_fingerprint": {
          "description": "Fingerprint of the current `SKILL.md` bytes.",
          "$ref": "#/$defs/Fingerprint"
        },
        "proposed_fingerprint": {
          "description": "Fingerprint of the proposed bytes.",
          "$ref": "#/$defs/Fingerprint"
        },
        "original_content": {
          "description": "Current `SKILL.md` text, for a side-by-side view.",
          "type": "string"
        },
        "proposed_content": {
          "description": "Proposed `SKILL.md` text, for a side-by-side view.",
          "type": "string"
        },
        "diff": {
          "description": "Unified diff for a person.",
          "type": "string"
        },
        "allowed_apply_modes": {
          "description": "Modes the caller may choose from.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepairApplyMode"
          }
        },
        "managed_update_warning": {
          "description": "Warning shown for [`RepairApplyMode::FixInstalledCopy`]: the next\nmanaged update overwrites the fix.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "proposal_id",
        "deployment_id",
        "path",
        "scope",
        "reason",
        "owner_kind",
        "expected_fingerprint",
        "proposed_fingerprint",
        "original_content",
        "proposed_content",
        "diff",
        "allowed_apply_modes"
      ]
    },
    "ProposalId": {
      "description": "Id of a frontmatter repair proposal.\n\nInvariant: sha256 over deployment id, path, owner id, owner kind, the\nexpected fingerprint, and the proposed text. Any change makes a new id.",
      "type": "string"
    },
    "DeploymentId": {
      "description": "Opaque deployment id.\n\nInvariant: the string starts with `dep:v1/`. Its internal layout is a core\ndetail; adapters and the UI compare it as a string and never split it.",
      "type": "string"
    },
    "RootScope": {
      "description": "Where a root lives.",
      "oneOf": [
        {
          "description": "Under the scope home.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "description": "Under one tracked project.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "project"
            },
            "project": {
              "$ref": "#/$defs/ProjectRef"
            }
          },
          "required": [
            "scope",
            "project"
          ]
        }
      ]
    },
    "ProjectRef": {
      "description": "Absolute path of a tracked project directory.\n\nInvariant: the path is canonical inside a [`crate::scope::NormalizedScope`].\nWire values are the lexical path the caller gave.",
      "type": "string"
    },
    "OwnerId": {
      "description": "Opaque lifecycle owner id.\n\nInvariant: the string starts with `owner:v1/`. It names the ledger entry\nthat installed the skill, not a path.",
      "type": "string"
    },
    "LifecycleOwnerKind": {
      "description": "Which ledger owns a deployment's lifecycle.",
      "oneOf": [
        {
          "description": "`~/.agents/.skill-lock.json`.",
          "type": "string",
          "const": "skills_sh"
        },
        {
          "description": "A dotagents ledger.",
          "type": "string",
          "const": "dotagents"
        },
        {
          "description": "A copy install recorded by Skill Studio.",
          "type": "string",
          "const": "copy"
        },
        {
          "description": "A fork recorded by Skill Studio.",
          "type": "string",
          "const": "fork"
        },
        {
          "description": "A harness plugin cache.",
          "type": "string",
          "const": "plugin"
        },
        {
          "description": "Committed in the project repository.",
          "type": "string",
          "const": "in_repo"
        },
        {
          "description": "Placed by hand.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "A dotagents wildcard entry.",
          "type": "string",
          "const": "wildcard_dotagents"
        },
        {
          "description": "More than one ledger claims the name.",
          "type": "string",
          "const": "ambiguous"
        }
      ]
    },
    "Fingerprint": {
      "description": "Content fingerprint in the `sha256:<hex>` form.\n\nInvariant: the hex is lowercase and 64 characters long. One scheme covers\nfiles, trees, and proposals; the old untyped hex form is parsed on read.",
      "type": "string"
    },
    "RepairApplyMode": {
      "description": "Ways a frontmatter repair may be applied.",
      "oneOf": [
        {
          "description": "Rewrite the file in place.",
          "type": "string",
          "const": "apply-fix"
        },
        {
          "description": "Rewrite the installed copy that a ledger owns.",
          "type": "string",
          "const": "fix-installed-copy"
        },
        {
          "description": "Fork first, then rewrite the fork.",
          "type": "string",
          "const": "fork-and-fix"
        }
      ]
    }
  }
}
