{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-internal-vocabulary": "off",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-raw-form-elements": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    // React Compiler-family rules not already reached by categories.correctness
    // (exhaustive-deps, purity, preserve-manual-memoization, etc. are already
    // "error" via correctness). rules-of-hooks/hooks/no-deriving-state-in-effects
    // found zero violations in src, so they go straight to "error".
    "react/rules-of-hooks": "error",
    "react/hooks": "error",
    "react/no-deriving-state-in-effects": "error",
    // These fire on real code but the remaining findings need a human call
    // (e.g. an effect keyed off a value only to retrigger, not to read it,
    // or a raw useState setter deliberately named apart from a wrapped
    // callback of the same base name), so they stay "warn" until someone
    // works through them by hand instead of being silenced.
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/hook-use-state": "error",
    // This app has no server-rendered/cached data layer: every list comes
    // from a Tauri IPC call, which is exactly the "external system" the
    // rule's own guidance says effects should synchronize with. Turning
    // this on would force a rewrite of every data-fetching component for
    // no behavior change.
    "react/set-state-in-effect": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist", "**/node_modules", "**/src-tauri/target", "**/src-tauri/gen"],
  "overrides": [
    {
      "files": ["apps/desktop/src/**", "packages/ui/**"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx", "apps/desktop/src/dev/**"],
      "rules": { "anti-slop/no-internal-vocabulary": "error" }
    },
    {
      "files": ["packages/ui/**", "apps/tui/**", "packages/marketing/**"],
      "rules": { "anti-slop/no-raw-form-elements": "off" }
    },
    {
      // Layering rule (plan.md section 7): components go through the store,
      // not straight to the IPC layer. The excludeFiles list is every
      // component that already imported skill-api.ts directly on main as
      // of unit 5.1; they're excluded so the rule doesn't block CI on
      // pre-existing code. Tracked in the unit 5.1 report for a follow-up
      // issue to move them onto the store.
      "files": ["apps/desktop/src/components/**"],
      "excludeFiles": [
        "apps/desktop/src/components/Activity/ActivityFilters.tsx",
        "apps/desktop/src/components/Activity/SkillHistorySection.tsx",
        "apps/desktop/src/components/AddSkill/AddSkillSheet.tsx",
        "apps/desktop/src/components/Home/HomeInboxGroups.tsx",
        "apps/desktop/src/components/Settings/AppVersionCard.tsx",
        "apps/desktop/src/components/Settings/CommandHealthCard.tsx",
        "apps/desktop/src/components/Settings/EditorCard.tsx",
        "apps/desktop/src/components/Settings/ProjectFoldersCard.tsx",
        "apps/desktop/src/components/Settings/TelemetryCard.tsx",
        "apps/desktop/src/components/SkillDetail/LeftBehindDialog.tsx",
        "apps/desktop/src/components/SkillDetail/MakeIndependentCopyDialog.tsx",
        "apps/desktop/src/components/SkillDetail/ParkCopyDialog.tsx",
        "apps/desktop/src/components/SkillDetail/RemoveDeploymentsDialog.tsx",
        "apps/desktop/src/components/SkillDetail/skill-location-actions.ts",
        "apps/desktop/src/components/SkillDetail/skill-page-actions.ts",
        "apps/desktop/src/components/SkillDetail/SkillCompareDialog.tsx",
        "apps/desktop/src/components/SkillDetail/SkillFrontmatterRepairDialog.tsx",
        "apps/desktop/src/components/SkillDetail/SkillPage.tsx",
        "apps/desktop/src/components/SkillDetail/SkillPropertiesRail.tsx",
        "apps/desktop/src/components/SkillDetail/SkillProposedEdits.tsx",
        "apps/desktop/src/components/SkillDetail/SkillRepairCard.tsx",
        "apps/desktop/src/components/SkillDetail/UninstallPluginDialog.tsx",
        "apps/desktop/src/components/SkillDetail/useSkillFrontmatterRepair.ts",
        "apps/desktop/src/components/SkillList/skill-bulk-run.ts",
        "apps/desktop/src/components/SkillList/useSkillBulkActions.ts",
        "apps/desktop/src/components/SkillList/useSkillListAct.ts",
        "apps/desktop/src/components/SkillStore/InstalledSkillLifecycleActions.tsx",
        "apps/desktop/src/components/SkillStore/SkillDetailPanel.tsx",
        "apps/desktop/src/components/SkillStore/SkillStore.tsx",
        "apps/desktop/src/components/SkillStore/SkillStoreInstallFlow.tsx",
        "apps/desktop/src/components/ui/MaterializeRootDialog.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "group": ["**/lib/skill-api", "@/lib/skill-api"],
                "message": "Components read and write skills through the store, not skill-api.ts directly. Add or use a store action instead."
              }
            ]
          }
        ]
      }
    },
    {
      // Layering rule (plan.md section 7): the store never imports back
      // into components.
      "files": ["apps/desktop/src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "group": ["**/components/**"],
                "message": "The store must not import from components; components depend on the store, not the other way around."
              }
            ]
          }
        ]
      }
    }
  ]
}
