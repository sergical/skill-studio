{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-internal-vocabulary": "off",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-raw-form-elements": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    // React Compiler-family rules that categories.correctness does not turn on.
    "react/rules-of-hooks": "error",
    "react/hooks": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/hook-use-state": "error",
    // This app has no server-rendered/cached data layer: every list comes
    // from a Tauri IPC call, which is exactly the "external system" the
    // rule's own guidance says effects should synchronize with. Turning
    // this on would force a rewrite of every data-fetching component for
    // no behavior change.
    "react/set-state-in-effect": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist", "**/node_modules", "**/src-tauri/target", "**/src-tauri/gen"],
  "overrides": [
    {
      "files": ["apps/desktop/src/**", "packages/ui/**"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx", "apps/desktop/src/dev/**"],
      "rules": { "anti-slop/no-internal-vocabulary": "error" }
    },
    {
      "files": ["packages/ui/**", "packages/marketing/**"],
      "rules": { "anti-slop/no-raw-form-elements": "off" }
    },
    {
      // Layering rule: components go through the store, not straight to the
      // IPC layer.
      "files": ["apps/desktop/src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/lib/skill-api", "@/lib/skill-api"],
                "message": "Components read and write skills through the store, not skill-api.ts directly. Add or use a store action instead."
              }
            ]
          }
        ]
      }
    },
    {
      // Layering rule: the store never imports back into components.
      "files": ["apps/desktop/src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**"],
                "message": "The store must not import from components; components depend on the store, not the other way around."
              }
            ]
          }
        ]
      }
    },
    {
      // Effects and timers need judgment to use well, so interface code gets
      // them only through the shared hooks in apps/desktop/src/hooks. "files"
      // lists the directories that are already clean. It only grows: add a
      // directory when its last effect and timer are gone. An override
      // replaces a rule's options, so this block repeats the layering
      // pattern from the components block above: without it these
      // directories would lose that rule.
      "files": [
        "apps/desktop/src/components/Activity/**",
        "apps/desktop/src/components/Coverage/**",
        "apps/desktop/src/components/FirstRun/**",
        "apps/desktop/src/components/Home/**",
        "apps/desktop/src/components/Learn/**",
        "apps/desktop/src/components/Listing/**",
        "apps/desktop/src/components/Packs/**",
        "apps/desktop/src/components/Sessions/**",
        "apps/desktop/src/components/Settings/**",
        "apps/desktop/src/components/Shell/**",
        "apps/desktop/src/components/Sidebar/**",
        "apps/desktop/src/components/dev/**",
        "apps/desktop/src/components/ui/**"
      ],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/lib/skill-api", "@/lib/skill-api"],
                "message": "Components read and write skills through the store, not skill-api.ts directly. Add or use a store action instead."
              }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect"],
                "message": "Effects live in apps/desktop/src/hooks. Load data with useLoad, read a cached report with useListingReport or useSessionsReport, listen with useBackendEvent or useWindowEvent, or derive the value during render and do the work in the event handler."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "property": "useEffect",
            "message": "Effects live in apps/desktop/src/hooks. Load data with useLoad, read a cached report with useListingReport or useSessionsReport, listen with useBackendEvent or useWindowEvent, or derive the value during render and do the work in the event handler."
          },
          {
            "property": "useLayoutEffect",
            "message": "Effects live in apps/desktop/src/hooks. Load data with useLoad, read a cached report with useListingReport or useSessionsReport, listen with useBackendEvent or useWindowEvent, or derive the value during render and do the work in the event handler."
          },
          {
            "property": "setTimeout",
            "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
          },
          {
            "property": "setInterval",
            "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
          },
          {
            "property": "requestAnimationFrame",
            "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
          },
          {
            "property": "requestIdleCallback",
            "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              {
                "name": "setTimeout",
                "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
              },
              {
                "name": "setInterval",
                "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
              },
              {
                "name": "requestAnimationFrame",
                "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
              },
              {
                "name": "requestIdleCallback",
                "message": "Timers live in apps/desktop/src/hooks. Use useDelayedCall for a delay, a reset or a debounce, and useNow for text that ages."
              }
            ]
          }
        ]
      }
    }
  ]
}
