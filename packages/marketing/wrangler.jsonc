{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skill-studio-site",
  "compatibility_date": "2026-09-30",
  "account_id": "a6221d3398c2e695ab8e1a2f1237bd1b",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [
    { "pattern": "useskillstudio.com", "custom_domain": true },
    { "pattern": "www.useskillstudio.com", "custom_domain": true },
  ],
  // Picks HTML or Markdown for docs URLs from the Accept header. Every other path is served
  // straight from the static files without running the script.
  "main": "./src/worker/site-worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/docs", "/docs/*"],
  },
}
