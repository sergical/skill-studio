{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skill-studio-site",
  "compatibility_date": "2026-09-30",
  "account_id": "a6221d3398c2e695ab8e1a2f1237bd1b",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [
    { "pattern": "useskillstudio.com", "custom_domain": true },
    { "pattern": "www.useskillstudio.com", "custom_domain": true },
  ],
  // Picks HTML or Markdown for docs URLs from the Accept header, and forwards the browser
  // SDK's Sentry envelopes from SITE_SENTRY_TUNNEL_PATH (src/site-links.ts). Every other path
  // is served straight from the static files without running the script.
  "main": "./src/worker/site-worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/docs", "/docs/*", "/m"],
  },
  // The same public DSN the build sets as VITE_SENTRY_DSN. The tunnel forwards envelopes for
  // this DSN only, so a browser DSN that differs is refused.
  "vars": {
    "SENTRY_DSN": "https://9da77532f66533d30d56ed257eb8e7f0@o4505994951065600.ingest.us.sentry.io/4512090769391616",
  },
}
