{
  "name": "@skill-studio/marketing",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host ${HOST:-localhost} --port ${PORT:-5173}",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender/site-prerender.tsx --outDir dist-ssr && node scripts/prerender-docs.mjs",
    "test": "vitest run",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "remotion:capture": "node scripts/capture-walkthroughs.mjs",
    "remotion:render": "node scripts/render-walkthroughs.mjs",
    "deploy": "node scripts/check-npm-release.mjs && pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.81",
    "@stylexjs/stylex": "0.19.0",
    "lucide-react": "^1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.520",
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "^18.0.14",
    "remotion": "^4.0.520",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.135.0"
  }
}
